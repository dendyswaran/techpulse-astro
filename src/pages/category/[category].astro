---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

export async function getStaticPaths() {
  const categories = [
    {
      slug: 'ai',
      title: 'Artificial Intelligence',
      desc: 'Foundation models, agentic architectures, inference economics, and automated vulnerability discovery.',
    },
    {
      slug: 'security',
      title: 'Security & Advisories',
      desc: 'In-depth technical analysis of zero-day exploits, CVE disclosures, cryptographic flaws, and runtime patches.',
    },
    {
      slug: 'tech-update',
      title: 'Systems & Runtimes',
      desc: 'Release notes, compiler improvements, and architectural changes across Node.js, Bun, Astro, and modern web toolchains.',
    },
    {
      slug: 'tech-news',
      title: 'Industry & Infrastructure',
      desc: 'Semiconductor supply chains, open-source governance, cloud infrastructure shifts, and engineering policy.',
    },
  ];

  const allArticles = await getCollection('articles');

  return categories.map((cat) => ({
    params: { category: cat.slug },
    props: {
      categorySlug: cat.slug,
      categoryTitle: cat.title,
      categoryDesc: cat.desc,
      articles: allArticles
        .filter((a) => a.data.category === cat.slug)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { categorySlug, categoryTitle, categoryDesc, articles } = Astro.props;
---

<BaseLayout
  title={`${categoryTitle} — TechPulse`}
  description={categoryDesc}
  activeNav={categorySlug}
>
  <div class="container-reading" style="padding-top:44px; padding-bottom:64px;">
    <header style="padding-bottom:28px; border-bottom:1px solid var(--hairline);">
      <div class="article-kicker" style="margin-bottom:8px;">
        <a href="/">All Stories</a>
        <span>/</span>
        <span>Section</span>
      </div>
      <h1
        class="font-serif"
        style="font-size:clamp(2rem, 3.5vw, 2.4rem); font-weight:600; letter-spacing:-0.025em; margin:0 0 10px 0;"
      >
        {categoryTitle}
      </h1>
      <p style="font-size:1.02rem; color:var(--ink-secondary); margin:0; line-height:1.55;">
        {categoryDesc}
      </p>
    </header>

    <div>
      {articles.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>
  </div>
</BaseLayout>
