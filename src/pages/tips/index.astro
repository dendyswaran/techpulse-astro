---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSortedTips, DIFFICULTY_LABEL, sourceHandle, formatTipDate } from '../../data/tips';

const SITE = 'https://www.techpulsenews.tech';
const tips = await getSortedTips();

const tagCounts = new Map<string, number>();
for (const tip of tips) {
  for (const tag of tip.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  }
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const pageTitle = 'Daily Tips: Prompting & AI Agent Orchestration for Developers | TechPulse';
const pageDesc =
  'Short, tested tips on prompting coding agents, managing context, subagents, MCP and cost — curated daily from the best developer posts, rewritten in plain words with full credit to the original authors.';

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE}/tips#collection`,
  name: 'TechPulse Daily Tips',
  description: pageDesc,
  url: `${SITE}/tips`,
  isPartOf: { '@id': `${SITE}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: tips.length,
    itemListElement: tips.map((tip, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      url: `${SITE}/tips/${tip.slug}`,
      name: tip.data.title,
    })),
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Tips', item: `${SITE}/tips` },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  activeNav="tips"
  canonicalPath="/tips"
  jsonLd={[collectionSchema, breadcrumbSchema]}
>
  <link slot="head" rel="alternate" type="application/rss+xml" title="TechPulse Daily Tips" href="/tips/rss.xml" />
  <div class="container-wide page-shell-wide">
    <header class="section-header-block tips-header">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li><a href="/">Home</a><span class="breadcrumb-sep" aria-hidden="true">/</span></li>
          <li><span class="breadcrumb-current" aria-current="page">Tips</span></li>
        </ol>
      </nav>
      <p class="tips-eyebrow">Daily · Prompting &amp; agent orchestration</p>
      <h1 class="section-display-title tips-title">Tips</h1>
      <p class="section-lead-copy">
        One practical technique at a time for developers who work with coding agents. Each tip is
        rewritten in our own words, checked for technical accuracy, and credits the post that inspired it.
      </p>
    </header>

    <div class="tips-index-layout">
      <div class="tips-filter" role="group" aria-label="Filter tips by tag">
        <button type="button" class="tips-filter-btn" data-tag-filter="all" aria-pressed="true">
          All <span class="tips-filter-count">{tips.length}</span>
        </button>
        {tags.map(([tag, count]) => (
          <button type="button" class="tips-filter-btn" data-tag-filter={tag} aria-pressed="false">
            {tag} <span class="tips-filter-count">{count}</span>
          </button>
        ))}
      </div>

      <p class="tips-filter-status" id="tips-filter-status" aria-live="polite"></p>

      <ol class="tips-index" id="tips-index" reversed>
        {tips.map((tip) => {
          const credit = tip.data.sources.find((s) => s.platform !== 'web') || tip.data.sources[0];
          return (
            <li class="tips-index-row" data-tags={tip.data.tags.join(' ')}>
              <div class="tips-index-num" aria-hidden="true">{tip.label}</div>
              <div class="tips-index-body">
                <h2 class="tips-index-title">
                  <a href={`/tips/${tip.slug}`}>{tip.data.title}</a>
                </h2>
                <p class="tips-index-desc">{tip.data.description}</p>
                <p class="tips-index-meta">
                  <time datetime={tip.data.pubDate.toISOString()}>{formatTipDate(tip.data.pubDate)}</time>
                  <span class="tips-meta-sep" aria-hidden="true">·</span>
                  <span>{DIFFICULTY_LABEL[tip.data.difficulty]}</span>
                  <span class="tips-meta-sep" aria-hidden="true">·</span>
                  <span>Inspired by {sourceHandle(credit)}</span>
                </p>
              </div>
            </li>
          );
        })}
      </ol>

      <p class="tips-empty" id="tips-empty" hidden>No tips with this tag yet.</p>

      <p class="tips-feed-note">
        Follow along: <a href="/tips/rss.xml">Tips RSS feed</a>
      </p>
    </div>
  </div>

  <script is:inline>
    (function () {
      var buttons = Array.prototype.slice.call(document.querySelectorAll('[data-tag-filter]'));
      var rows = Array.prototype.slice.call(document.querySelectorAll('#tips-index .tips-index-row'));
      var empty = document.getElementById('tips-empty');
      var status = document.getElementById('tips-filter-status');
      if (!buttons.length) return;

      function apply(tag, updateUrl) {
        var known = buttons.some(function (b) { return b.getAttribute('data-tag-filter') === tag; });
        if (!known) tag = 'all';
        var shown = 0;
        rows.forEach(function (row) {
          var match = tag === 'all' || (' ' + row.getAttribute('data-tags') + ' ').indexOf(' ' + tag + ' ') !== -1;
          row.hidden = !match;
          if (match) shown++;
        });
        buttons.forEach(function (b) {
          b.setAttribute('aria-pressed', b.getAttribute('data-tag-filter') === tag ? 'true' : 'false');
        });
        empty.hidden = shown !== 0;
        status.textContent = tag === 'all' ? '' : shown + (shown === 1 ? ' tip' : ' tips') + ' tagged ' + tag;
        if (updateUrl) {
          var url = new URL(window.location.href);
          if (tag === 'all') url.searchParams.delete('tag');
          else url.searchParams.set('tag', tag);
          history.replaceState(null, '', url.pathname + url.search);
        }
      }

      buttons.forEach(function (b) {
        b.addEventListener('click', function () {
          apply(b.getAttribute('data-tag-filter'), true);
        });
      });

      var initial = new URLSearchParams(window.location.search).get('tag');
      if (initial) apply(initial, false);
    })();
  </script>
</BaseLayout>
