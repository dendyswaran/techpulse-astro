---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getMergedCveRecords } from '../data/cves';

const SITE = 'https://www.techpulsenews.tech';

const allArticles = (await getCollection('articles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const securityArticles = allArticles.filter(
  (a) =>
    a.data.category === 'security' ||
    (a.data.cveIds && a.data.cveIds.length > 0)
);

const cveRecords = getMergedCveRecords(allArticles);

const securityPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE}/security#collection`,
  name: 'CVE & Vulnerability Advisory Index — TechPulse',
  description:
    'Structured index of active Common Vulnerabilities and Exposures (CVE), CVSS scores, affected branches, and patched runtime releases across Node.js, Bun, PHP, Java SE, UEFI, Veeam, and AI infrastructure.',
  url: `${SITE}/security`,
  isPartOf: { '@id': `${SITE}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    name: 'Active October 2026 Runtime & Infrastructure CVEs',
    numberOfItems: cveRecords.length,
    itemListElement: cveRecords.map((row, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: `${row.id} — ${row.component} (${row.severity}, CVSS ${row.cvss})`,
      url: `${SITE}/cve/${row.slugId}`,
    })),
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${SITE}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'CVE & Advisory Index',
      item: `${SITE}/security`,
    },
  ],
};
---

<BaseLayout
  title="CVE & Vulnerability Advisory Index (October 2026) — TechPulse"
  description="Structured index of active Common Vulnerabilities and Exposures (CVE), CVSS scores, affected branches, and patched releases across Node.js, Bun, PHP, Java SE, UEFI, Veeam, and AI infrastructure."
  activeNav="cve-matrix"
  canonicalPath="/security"
  ogImage={securityArticles[0]?.data.coverImage}
  ogImageAlt="TechPulse CVE & Vulnerability Advisory Index"
  jsonLd={[securityPageSchema, breadcrumbSchema]}
>
  <div class="container-wide page-shell-wide">
    <header class="section-header-block">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li>
            <a href="/">Home</a>
            <span class="breadcrumb-sep">/</span>
          </li>
          <li>
            <span class="breadcrumb-current" aria-current="page">CVE &amp; Advisory Index</span>
          </li>
        </ol>
      </nav>

      <div class="article-kicker" style="margin-bottom:10px;">
        <span>Security Ledger</span>
        <span>·</span>
        <span>October 2026</span>
      </div>
      <h1 class="section-display-title">
        Vulnerability &amp; Advisory Index
      </h1>
      <p class="section-lead-copy">
        Verified Common Vulnerabilities and Exposures across server runtimes, language toolchains, boot firmware, and enterprise backup stacks, indexed with dedicated CVE datasheets, affected branches, and upstream patch releases.
      </p>
    </header>

    <!-- Minimal Filter Tabs -->
    <div class="category-tabs" role="tablist" aria-label="Filter advisories by severity" style="margin-bottom:8px;">
      <button type="button" role="tab" aria-selected="true" class="cat-tab active" data-sev-filter="ALL">
        All Advisories ({cveRecords.length})
      </button>
      <button type="button" role="tab" aria-selected="false" class="cat-tab" data-sev-filter="CRITICAL">
        Critical (CVSS ≥ 9.0)
      </button>
      <button type="button" role="tab" aria-selected="false" class="cat-tab" data-sev-filter="HIGH">
        High (7.0 – 8.9)
      </button>
      <button type="button" role="tab" aria-selected="false" class="cat-tab" data-sev-filter="MEDIUM">
        Medium
      </button>
    </div>

    <!-- Clean Technical Specification Table -->
    <div class="cve-table-wrap">
      <table class="cve-spec-table">
        <thead>
          <tr>
            <th scope="col">Identifier</th>
            <th scope="col">Component / Vector</th>
            <th scope="col">Severity</th>
            <th scope="col">Affected Branches</th>
            <th scope="col">Patched Release</th>
            <th scope="col">Advisory</th>
          </tr>
        </thead>
        <tbody id="cve-table-body">
          {cveRecords.map((row) => (
            <tr data-row-sev={row.severity}>
              <td>
                <a href={`/cve/${row.slugId}`} class="cve-id-link" title={`View ${row.id} technical datasheet`}>
                  {row.id}
                </a>
              </td>
              <td style="font-weight:500; color:var(--ink);">
                <a href={`/cve/${row.slugId}`} style="color:inherit;">
                  {row.component}
                </a>
              </td>
              <td class="font-mono" style="font-size:0.78rem; white-space:nowrap;">
                <span class={`severity-${row.severity}`} style="font-weight:500;">
                  {row.severity} · {row.cvss}
                </span>
              </td>
              <td class="font-mono" style="font-size:0.78rem; color:var(--ink-secondary);">
                {row.affected}
              </td>
              <td class="font-mono" style="font-size:0.78rem; color:var(--ink);">
                {row.patched}
              </td>
              <td style="white-space:nowrap;">
                <a href={`/cve/${row.slugId}`} class="cve-read-link" style="margin-right:10px;">
                  Datasheet
                </a>
                <a href={`/articles/${row.articleSlug}`} class="cve-read-link">
                  Article →
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Security Dispatches -->
    <section style="max-width:680px;">
      <h2
        class="sidebar-heading"
        style="padding-bottom:12px; border-bottom:1px solid var(--hairline); margin-bottom:0;"
      >
        <span>Security Dispatches &amp; Post-Mortems</span>
      </h2>
      <div>
        {securityArticles.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      var btns = document.querySelectorAll('[data-sev-filter]');
      var rows = document.querySelectorAll('#cve-table-body tr');
      btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var sev = btn.getAttribute('data-sev-filter');
          btns.forEach(function (b) {
            var isSel = b === btn;
            b.classList.toggle('active', isSel);
            b.setAttribute('aria-selected', isSel ? 'true' : 'false');
          });
          rows.forEach(function (row) {
            var rSev = row.getAttribute('data-row-sev');
            row.style.display = sev === 'ALL' || rSev === sev ? '' : 'none';
          });
          if (window.tpTrack) {
            window.tpTrack('cve_severity_filter', { severity: sev });
          }
        });
      });
    })();
  </script>
</BaseLayout>
