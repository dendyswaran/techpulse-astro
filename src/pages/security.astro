---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';

const allArticles = (await getCollection('articles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const securityArticles = allArticles.filter(
  (a) =>
    a.data.category === 'security' ||
    (a.data.cveIds && a.data.cveIds.length > 0)
);

const cveRecords = [
  {
    id: 'CVE-2026-111497',
    component: 'Node.js Brotli Stream Decoder',
    severity: 'CRITICAL',
    cvss: '9.8',
    affected: '20.x, 22.x, 24.x, 25.x',
    patched: 'v20.20.4, v22.22.4, v24.16.0, v25.10.0',
    slug: 'nodejs-october-2026-brotli-rce-cve-2026-111497',
  },
  {
    id: 'CVE-2026-109618',
    component: 'PHP SAPI Multipart Parser (php2shell)',
    severity: 'CRITICAL',
    cvss: '9.2',
    affected: '8.2.x < 8.2.28, 8.3.x < 8.3.19, 8.4.x < 8.4.6',
    patched: 'PHP 8.2.28, 8.3.19, 8.4.6',
    slug: 'php2shell-rce-cve-2026-109618-ditemukan-ai',
  },
  {
    id: 'GHSA-cf8x-9m69',
    component: 'Bun HTTP/3 QPACK Decoder',
    severity: 'HIGH',
    cvss: '9.2',
    affected: 'Bun < v1.4.4',
    patched: 'Bun v1.4.4',
    slug: 'bun-v1-4-4-http3-qpack-brotli-emudhra-security',
  },
  {
    id: 'CVE-2026-91403',
    component: 'Oracle Java SE / GraalVM JSSE TLS',
    severity: 'CRITICAL',
    cvss: '9.1',
    affected: 'JDK 8u431, 11.0.25, 17.0.13, 21.0.5, 25.0.1',
    patched: 'Oracle Out-of-Band Security Alert Patch',
    slug: 'oracle-java-jsse-cve-2026-91403-out-of-band-alert',
  },
  {
    id: 'CVE-2026-111500',
    component: 'Node.js TLS ALPN Callback Race',
    severity: 'HIGH',
    cvss: '8.1',
    affected: 'Node.js 22.x, 24.x, 25.x',
    patched: 'v22.22.4, v24.16.0, v25.10.0',
    slug: 'nodejs-october-2026-brotli-rce-cve-2026-111497',
  },
  {
    id: 'CVE-2026-111508',
    component: 'Node.js Permission Model FS Bypass',
    severity: 'HIGH',
    cvss: '7.7',
    affected: 'Node.js 20.x, 22.x, 24.x, 25.x',
    patched: 'v20.20.4, v22.22.4, v24.16.0, v25.10.0',
    slug: 'nodejs-october-2026-brotli-rce-cve-2026-111497',
  },
  {
    id: 'GHSA-54x7-74r2',
    component: 'Bun Node.js Brotli Stream Port',
    severity: 'HIGH',
    cvss: '7.5',
    affected: 'Bun < v1.4.4',
    patched: 'Bun v1.4.4',
    slug: 'bun-v1-4-4-http3-qpack-brotli-emudhra-security',
  },
  {
    id: 'CVE-2026-111510',
    component: 'Node.js HTTP/2 CONTINUATION Flood',
    severity: 'HIGH',
    cvss: '7.5',
    affected: 'Node.js 20.x, 22.x, 24.x, 25.x',
    patched: 'v20.20.4, v22.22.4, v24.16.0, v25.10.0',
    slug: 'nodejs-october-2026-brotli-rce-cve-2026-111497',
  },
  {
    id: 'CVE-2026-111498',
    component: 'Node.js llhttp Chunked Extension Smuggling',
    severity: 'MEDIUM',
    cvss: '6.5',
    affected: 'Node.js 20.x, 22.x, 24.x, 25.x',
    patched: 'v20.20.4, v22.22.4, v24.16.0, v25.10.0',
    slug: 'nodejs-october-2026-brotli-rce-cve-2026-111497',
  },
];
---

<BaseLayout
  title="CVE & Advisory Index — TechPulse"
  description="Structured index of active Common Vulnerabilities and Exposures (CVE), CVSS v3.1 scores, and patched runtime releases."
  activeNav="cve-matrix"
>
  <div class="container-wide" style="padding-top:44px; padding-bottom:64px;">
    <header style="max-width:680px; margin-bottom:36px;">
      <div class="article-kicker" style="margin-bottom:10px;">
        <span>Security Ledger</span>
        <span>·</span>
        <span>October 2026</span>
      </div>
      <h1
        class="font-serif"
        style="font-size:clamp(2rem, 3.6vw, 2.5rem); font-weight:600; letter-spacing:-0.025em; line-height:1.15; margin:0 0 12px 0;"
      >
        Vulnerability & Advisory Index
      </h1>
      <p style="font-size:1.05rem; color:var(--ink-secondary); line-height:1.55; margin:0;">
        Verified Common Vulnerabilities and Exposures across server runtimes, language toolchains, and enterprise cryptography stacks, indexed with affected branches and upstream patch releases.
      </p>
    </header>

    <!-- Minimal Filter Tabs -->
    <div class="category-tabs" style="margin-bottom:8px;">
      <button type="button" class="cat-tab active" data-sev-filter="ALL">
        All Advisories ({cveRecords.length})
      </button>
      <button type="button" class="cat-tab" data-sev-filter="CRITICAL">
        Critical (CVSS ≥ 9.0)
      </button>
      <button type="button" class="cat-tab" data-sev-filter="HIGH">
        High (7.0 – 8.9)
      </button>
      <button type="button" class="cat-tab" data-sev-filter="MEDIUM">
        Medium
      </button>
    </div>

    <!-- Clean Technical Specification Table -->
    <div class="cve-table-wrap" style="margin-bottom:56px;">
      <table class="cve-spec-table">
        <thead>
          <tr>
            <th>Identifier</th>
            <th>Component / Vector</th>
            <th>Severity</th>
            <th>Affected Branches</th>
            <th>Patched Release</th>
            <th style="text-align:right;">Analysis</th>
          </tr>
        </thead>
        <tbody id="cve-table-body">
          {cveRecords.map((row) => (
            <tr data-row-sev={row.severity}>
              <td class="font-mono" style="font-weight:500; font-size:0.8125rem; white-space:nowrap;">
                <a href={`/articles/${row.slug}`} style="text-decoration:underline; text-underline-offset:3px; text-decoration-color:var(--hairline-strong);">
                  {row.id}
                </a>
              </td>
              <td style="font-weight:500; color:var(--ink);">{row.component}</td>
              <td class="font-mono" style="font-size:0.78rem; white-space:nowrap;">
                <span class={`severity-${row.severity}`} style="font-weight:500;">
                  {row.severity} · {row.cvss}
                </span>
              </td>
              <td class="font-mono" style="font-size:0.78rem; color:var(--ink-secondary);">
                {row.affected}
              </td>
              <td class="font-mono" style="font-size:0.78rem; color:var(--ink);">
                {row.patched}
              </td>
              <td style="text-align:right; white-space:nowrap;">
                <a
                  href={`/articles/${row.slug}`}
                  style="font-size:0.8125rem; color:var(--ink-secondary); text-decoration:underline; text-underline-offset:3px;"
                >
                  Read →
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Security Dispatches -->
    <section style="max-width:680px;">
      <h2
        class="sidebar-heading"
        style="padding-bottom:12px; border-bottom:1px solid var(--hairline); margin-bottom:0;"
      >
        <span>Security Dispatches & Post-Mortems</span>
      </h2>
      <div>
        {securityArticles.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      var btns = document.querySelectorAll('[data-sev-filter]');
      var rows = document.querySelectorAll('#cve-table-body tr');
      btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var sev = btn.getAttribute('data-sev-filter');
          btns.forEach(function (b) {
            b.classList.toggle('active', b === btn);
          });
          rows.forEach(function (row) {
            var rSev = row.getAttribute('data-row-sev');
            row.style.display = sev === 'ALL' || rSev === sev ? '' : 'none';
          });
        });
      });
    })();
  </script>
</BaseLayout>
