---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await article.render();

const {
  title,
  subtitle,
  pubDate,
  category,
  tags,
  readingTime,
  author,
  coverImage,
  coverAlt,
  coverCaption,
  tldr,
  cveIds,
  severity,
  cvss,
  affectedVersions,
  patchedVersions,
  sources,
} = article.data;

const categoryLabel: Record<string, string> = {
  ai: 'AI',
  security: 'Security',
  'tech-update': 'Systems',
  'tech-news': 'Industry',
};

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const allArticles = (await getCollection('articles'))
  .filter((a) => a.slug !== article.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const relatedArticles = allArticles
  .filter((a) => a.data.category === category)
  .slice(0, 3);
---

<BaseLayout
  title={`${title} — TechPulse`}
  description={subtitle}
  activeNav={category}
  ogImage={coverImage}
>
  <div class="progress-bar" id="reading-progress-bar"></div>

  <article class="container-reading">
    <header class="article-header">
      <div class="article-kicker">
        <a href={`/category/${category}`}>
          {categoryLabel[category] || category}
        </a>
        <span>·</span>
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        <span>·</span>
        <span>{readingTime}</span>
      </div>

      <h1 class="article-headline">{title}</h1>
      <p class="article-deck">{subtitle}</p>

      <div class="article-byline-bar">
        <div class="byline-author-block">
          <span class="byline-author-name">{author.name}</span>
          <span class="byline-author-role">
            {author.role} · {readingTime}
          </span>
        </div>

        <div class="byline-actions">
          <button
            type="button"
            class="byline-icon-btn"
            id="font-size-cycle-btn"
            title="Cycle reading font size"
            aria-label="Cycle reading font size"
          >
            Aa
          </button>

          <button
            type="button"
            class="byline-icon-btn"
            data-bookmark-slug={article.slug}
            title="Save to reading list"
            aria-label="Bookmark article"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
            </svg>
          </button>

          <button
            type="button"
            class="byline-icon-btn"
            id="copy-link-btn"
            title="Copy article link"
            aria-label="Copy article link"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
            </svg>
          </button>
        </div>
      </div>

      {coverImage && (
        <figure class="article-cover-figure">
          <img
            src={coverImage}
            alt={coverAlt || title}
            width="1200"
            height="675"
            loading="eager"
            decoding="async"
            class="article-cover-img"
          />
          {coverCaption && (
            <figcaption class="article-cover-caption">{coverCaption}</figcaption>
          )}
        </figure>
      )}
    </header>

    <!-- Editorial Abstract / Margin Rule (The Brief) -->
    {tldr && tldr.length > 0 && (
      <aside class="editorial-brief" aria-label="The Brief">
        <div class="editorial-brief-label">The Brief</div>
        <ul>
          {tldr.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </aside>
    )}

    <!-- Compact Technical Advisory Metadata (for CVE / Security Articles) -->
    {cveIds && cveIds.length > 0 && (
      <section class="spec-datasheet" aria-label="Vulnerability Specification">
        <div class="spec-row">
          <div class="spec-key">Identifier</div>
          <div class="spec-val">{cveIds.join(', ')}</div>
        </div>
        {(severity || cvss) && (
          <div class="spec-row">
            <div class="spec-key">Severity</div>
            <div class={`spec-val ${severity ? `severity-${severity}` : ''}`} style="font-weight:500;">
              {severity || 'ADVISORY'}{cvss ? ` · CVSS ${cvss}` : ''}
            </div>
          </div>
        )}
        {affectedVersions && (
          <div class="spec-row">
            <div class="spec-key">Affected</div>
            <div class="spec-val">{affectedVersions}</div>
          </div>
        )}
        {patchedVersions && (
          <div class="spec-row">
            <div class="spec-key">Patched</div>
            <div class="spec-val">{patchedVersions}</div>
          </div>
        )}
      </section>
    )}

    <!-- Main Essay Body (Medium 20px Serif, 1.8 line-height, 680px measure) -->
    <div class="prose-editorial">
      <Content />
    </div>

    <!-- Topic Tags -->
    <div class="topic-pills-wrap" style="margin-top:44px;">
      {tags.map((tag) => (
        <a href={`/?tag=${encodeURIComponent(tag)}`} class="topic-pill">
          {tag}
        </a>
      ))}
    </div>

    <!-- Footnote-style Primary Sources -->
    {sources && sources.length > 0 && (
      <section class="sources-block">
        <h2 class="sources-heading">Sources &amp; Primary Advisories</h2>
        <ol class="sources-list">
          {sources.map((src) => (
            <li>
              <a
                href={src.url}
                target="_blank"
                rel="noopener noreferrer"
                class="source-link"
              >
                {src.label}
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- Further Reading -->
    {relatedArticles.length > 0 && (
      <section style="margin-top:56px; padding-top:32px; border-top:1px solid var(--hairline);">
        <h2 class="sources-heading" style="margin-bottom:4px;">
          More in {categoryLabel[category] || category}
        </h2>
        <div>
          {relatedArticles.map((rel) => (
            <ArticleCard article={rel} />
          ))}
        </div>
      </section>
    )}
  </article>

  <script is:inline>
    (function () {
      var bar = document.getElementById('reading-progress-bar');
      window.addEventListener(
        'scroll',
        function () {
          if (!bar) return;
          var docHeight =
            document.documentElement.scrollHeight -
            document.documentElement.clientHeight;
          var pct = docHeight > 0 ? (window.scrollY / docHeight) * 100 : 0;
          bar.style.width = Math.min(100, Math.max(0, pct)) + '%';
        },
        { passive: true }
      );

      var sizes = ['1.125rem', '1.25rem', '1.375rem'];
      var fontBtn = document.getElementById('font-size-cycle-btn');
      if (fontBtn) {
        fontBtn.addEventListener('click', function () {
          var current =
            document.documentElement.style.getPropertyValue('--article-font-size') ||
            '1.25rem';
          var idx = sizes.indexOf(current.trim());
          var next = sizes[(idx + 1) % sizes.length];
          document.documentElement.style.setProperty('--article-font-size', next);
          try {
            localStorage.setItem('techpulse-font-size', next);
          } catch (e) {}
        });
      }

      var copyBtn = document.getElementById('copy-link-btn');
      if (copyBtn) {
        copyBtn.addEventListener('click', function () {
          if (navigator.clipboard) {
            navigator.clipboard.writeText(window.location.href);
            var orig = copyBtn.innerHTML;
            copyBtn.textContent = '✓';
            setTimeout(function () {
              copyBtn.innerHTML = orig;
            }, 1400);
          }
        });
      }
    })();
  </script>
</BaseLayout>
