---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await article.render();

const {
  title,
  subtitle,
  pubDate,
  updatedDate,
  category,
  tags,
  readingTime,
  author,
  tldr,
  cveIds,
  severity,
  cvss,
  affectedVersions,
  patchedVersions,
  sources,
} = article.data;

const allArticles = await getCollection('articles');
const relatedArticles = allArticles
  .filter((a) => a.slug !== article.slug)
  .sort((a, b) => {
    const sameCatA = a.data.category === category ? 1 : 0;
    const sameCatB = b.data.category === category ? 1 : 0;
    if (sameCatA !== sameCatB) return sameCatB - sameCatA;
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  })
  .slice(0, 3);

const categoryLabel: Record<string, string> = {
  ai: 'Artificial Intelligence',
  security: 'Security & Vulnerability',
  'tech-update': 'Tech Updates',
  'tech-news': 'Tech News',
};

const formattedPub = pubDate.toLocaleDateString('en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const formattedUpd = updatedDate
  ? updatedDate.toLocaleDateString('en-US', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : null;

const initials = author.name
  .split(' ')
  .slice(0, 2)
  .map((w) => w[0])
  .join('')
  .toUpperCase();
---

<BaseLayout title={`${title} — TechPulse`} description={subtitle} activeNav={category}>
  <div class="reading-progress-bar" id="reading-progress"></div>

  <article class="article-column">
    <!-- Top Meta & Font Size Controls -->
    <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-bottom:10px;">
      <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; font-size:0.84rem; color:var(--ink-secondary);">
        <a href={`/category/${category}`} class={`badge badge-${category}`}>
          {categoryLabel[category] || category}
        </a>
        <span>·</span>
        <time datetime={pubDate.toISOString()}>{formattedPub}</time>
        {formattedUpd && <span>(Updated {formattedUpd})</span>}
        <span>·</span>
        <span>{readingTime}</span>
      </div>

      <div style="display:inline-flex; align-items:center; gap:4px; background:var(--bg-subtle); border:1px solid var(--border); border-radius:999px; padding:2px 6px;" aria-label="Article Font Size">
        <button type="button" class="theme-btn" data-font-size="1.12rem" title="Smaller text">A-</button>
        <button type="button" class="theme-btn" data-font-size="1.25rem" title="Default Medium text size">A</button>
        <button type="button" class="theme-btn" data-font-size="1.38rem" title="Larger text">A+</button>
      </div>
    </div>

    <!-- Editorial Title & Subtitle -->
    <h1 class="article-headline">{title}</h1>
    <p class="article-subheadline">{subtitle}</p>

    <!-- Author Bar & Share/Bookmark Controls -->
    <div class="article-author-bar">
      <div style="display:flex; align-items:center; gap:12px;">
        <span class="author-avatar" style="width:40px; height:40px; font-size:0.9rem;">{initials}</span>
        <div>
          <div style="font-weight:700; font-size:0.95rem; color:var(--ink);">{author.name}</div>
          <div style="font-size:0.8rem; color:var(--ink-muted);">{author.role}</div>
        </div>
      </div>

      <div style="display:flex; align-items:center; gap:10px;">
        <button
          type="button"
          class="bookmark-btn"
          data-bookmark-slug={article.slug}
          style="border:1px solid var(--border); padding:6px 12px;"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
          </svg>
          <span class="bm-label">Save</span>
        </button>

        <button
          type="button"
          id="copy-link-btn"
          class="bookmark-btn"
          style="border:1px solid var(--border); padding:6px 12px;"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
          <span id="copy-link-label">Copy Link</span>
        </button>
      </div>
    </div>

    <!-- Quick Summary (TL;DR) Card -->
    {tldr && tldr.length > 0 && (
      <section class="tldr-box" aria-label="Quick Summary TL;DR">
        <h2 class="tldr-box-title">
          <span>✦</span> Quick Summary (TL;DR)
        </h2>
        <ul>
          {tldr.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    )}

    <!-- Security Vulnerability Advisory Box (for CVE articles) -->
    {cveIds && cveIds.length > 0 && (
      <section class="advisory-card" aria-label="Security Vulnerability Advisory">
        <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;">
          <div style="font-size:0.82rem; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:var(--crit-text);">
            🛡️ Security Vulnerability Advisory
          </div>
          {severity && (
            <span class={`severity-badge severity-${severity}`}>
              {severity} {cvss ? `· CVSS ${cvss}` : ''}
            </span>
          )}
        </div>

        <div class="advisory-grid">
          <div>
            <div class="advisory-item-label">CVE / GHSA IDs</div>
            <div class="advisory-item-val">{cveIds.join(', ')}</div>
          </div>
          {affectedVersions && (
            <div>
              <div class="advisory-item-label">Affected Versions</div>
              <div class="advisory-item-val">{affectedVersions}</div>
            </div>
          )}
          {patchedVersions && (
            <div>
              <div class="advisory-item-label">Patched Versions</div>
              <div class="advisory-item-val" style="color:var(--accent);">{patchedVersions}</div>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- Main Article Prose Content -->
    <div class="prose">
      <Content />
    </div>

    <!-- Topic Tags -->
    <div style="margin-top:36px; padding-top:20px; border-top:1px solid var(--border); display:flex; flex-wrap:wrap; gap:8px;">
      {tags.map((tag) => (
        <span class="tag-pill">{tag}</span>
      ))}
    </div>

    <!-- Verified Official Sources -->
    {sources && sources.length > 0 && (
      <section
        style="margin-top:32px; background:var(--bg-subtle); border:1px solid var(--border); border-radius:10px; padding:20px 24px;"
        aria-label="Verified References and Official Sources"
      >
        <h3 style="margin:0 0 12px; font-size:0.88rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:var(--ink);">
          Verified References & Official Sources
        </h3>
        <ul style="margin:0; padding-left:18px; font-size:0.88rem; line-height:1.65;">
          {sources.map((src) => (
            <li style="margin-bottom:6px;">
              <a
                href={src.url}
                target="_blank"
                rel="noopener noreferrer"
                style="color:var(--accent); font-weight:600; text-decoration:underline;"
              >
                {src.label}
              </a>
              <span class="font-mono" style="display:block; font-size:0.75rem; color:var(--ink-muted); word-break:break-all;">
                {src.url}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Related Articles -->
    <section style="margin-top:52px; padding-top:32px; border-top:1px solid var(--border);">
      <h3 class="font-serif" style="font-size:1.35rem; margin:0 0 20px; color:var(--ink);">
        Related Stories on TechPulse
      </h3>
      <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap:20px;">
        {relatedArticles.map((rel) => (
          <a
            href={`/articles/${rel.slug}`}
            style="display:block; padding:16px; border:1px solid var(--border); border-radius:8px; background:var(--bg-card);"
          >
            <span class={`badge badge-${rel.data.category}`} style="margin-bottom:8px;">
              {categoryLabel[rel.data.category]}
            </span>
            <h4 class="font-serif" style="font-size:1.05rem; line-height:1.35; margin:0 0 6px; color:var(--ink);">
              {rel.data.title}
            </h4>
            <span style="font-size:0.76rem; color:var(--ink-muted);">{rel.data.readingTime}</span>
          </a>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      // Reading progress bar
      var progressBar = document.getElementById('reading-progress');
      window.addEventListener('scroll', function () {
        if (!progressBar) return;
        var scrollTop = window.scrollY || document.documentElement.scrollTop;
        var docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        var pct = docHeight > 0 ? Math.min(100, Math.max(0, (scrollTop / docHeight) * 100)) : 0;
        progressBar.style.width = pct + '%';
      });

      // Font size controls
      document.querySelectorAll('[data-font-size]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var sz = btn.getAttribute('data-font-size');
          if (!sz) return;
          document.documentElement.style.setProperty('--article-font-size', sz);
          try {
            localStorage.setItem('techpulse-font-size', sz);
          } catch (e) {}
        });
      });

      // Copy link button
      var copyBtn = document.getElementById('copy-link-btn');
      var copyLabel = document.getElementById('copy-link-label');
      if (copyBtn && copyLabel) {
        copyBtn.addEventListener('click', function () {
          if (navigator.clipboard) {
            navigator.clipboard.writeText(window.location.href);
          }
          copyLabel.textContent = 'Link Copied ✓';
          setTimeout(function () {
            copyLabel.textContent = 'Copy Link';
          }, 2000);
        });
      }
    })();
  </script>
</BaseLayout>
