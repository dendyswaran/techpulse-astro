---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { toCveSlug } from '../../data/cves';

const SITE = 'https://www.techpulsenews.tech';

export async function getStaticPaths() {
  const articles = (await getCollection('articles')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  return articles.map((article, idx) => ({
    params: { slug: article.slug },
    props: {
      article,
      newerArticle: idx > 0 ? articles[idx - 1] : null,
      olderArticle: idx < articles.length - 1 ? articles[idx + 1] : null,
    },
  }));
}

const { article, newerArticle, olderArticle } = Astro.props;
const { Content } = await article.render();

const {
  title,
  subtitle,
  pubDate,
  updatedDate,
  category,
  tags,
  readingTime,
  author,
  coverImage,
  coverAlt,
  coverCaption,
  tldr,
  cveIds,
  severity,
  cvss,
  affectedVersions,
  patchedVersions,
  sources,
} = article.data;

const categoryLabel: Record<string, string> = {
  ai: 'AI',
  security: 'Security',
  'tech-update': 'Systems',
  'tech-news': 'Industry',
};

const categoryFullTitle: Record<string, string> = {
  ai: 'Artificial Intelligence',
  security: 'Security & Advisories',
  'tech-update': 'Systems & Runtimes',
  'tech-news': 'Industry & Infrastructure',
};

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const allArticles = (await getCollection('articles'))
  .filter((a) => a.slug !== article.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const relatedArticles = allArticles
  .filter((a) => a.data.category === category)
  .slice(0, 3);

const canonicalArticleUrl = `${SITE}/articles/${article.slug}`;
const absCoverUrl = coverImage
  ? `${SITE}${coverImage}`
  : `${SITE}/images/covers/openai-gpt-6-1-terra-mirendil-fern-10m-context.webp`;

const encodedUrl = encodeURIComponent(canonicalArticleUrl);
const encodedTitle = encodeURIComponent(`${title} — TechPulse`);
const xShareUrl = `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
const hnShareUrl = `https://news.ycombinator.com/submitlink?u=${encodedUrl}&t=${encodeURIComponent(title)}`;
const linkedinShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;

const rawBody = article.body || '';
const wordCount = rawBody
  .replace(/```[\s\S]*?```/g, ' ')
  .replace(/[#>*_`~\[\]()|-]/g, ' ')
  .split(/\s+/)
  .filter(Boolean).length;

const allKeywords = Array.from(new Set([...(tags || []), ...(cveIds || [])]));

const newsArticleSchema = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  '@id': `${canonicalArticleUrl}#article`,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalArticleUrl,
  },
  headline: title,
  alternativeHeadline: subtitle,
  description: subtitle,
  image: [
    {
      '@type': 'ImageObject',
      url: absCoverUrl,
      width: 1200,
      height: 675,
      caption: coverCaption || coverAlt || title,
    },
  ],
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate || pubDate).toISOString(),
  author: [
    {
      '@type': 'Person',
      name: author.name,
      jobTitle: author.role,
      url: `${SITE}/`,
    },
  ],
  publisher: {
    '@id': `${SITE}/#organization`,
  },
  isPartOf: {
    '@id': `${SITE}/#website`,
  },
  articleSection: categoryFullTitle[category] || categoryLabel[category] || category,
  keywords: allKeywords.join(', '),
  wordCount,
  inLanguage: 'en-US',
  isAccessibleForFree: true,
  ...(sources && sources.length > 0
    ? {
        citation: sources.map((s) => ({
          '@type': 'CreativeWork',
          name: s.label,
          url: s.url,
        })),
      }
    : {}),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${SITE}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: categoryFullTitle[category] || categoryLabel[category] || category,
      item: `${SITE}/category/${category}`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: canonicalArticleUrl,
    },
  ],
};
---

<BaseLayout
  title={`${title} — TechPulse`}
  description={subtitle}
  activeNav={category}
  canonicalPath={`/articles/${article.slug}`}
  ogType="article"
  ogImage={coverImage}
  ogImageAlt={coverAlt || title}
  preloadImage={coverImage}
  publishedTime={pubDate.toISOString()}
  modifiedTime={(updatedDate || pubDate).toISOString()}
  authorName={author.name}
  section={categoryFullTitle[category] || categoryLabel[category] || category}
  tags={allKeywords}
  jsonLd={[newsArticleSchema, breadcrumbSchema]}
>
  <div class="progress-bar" id="reading-progress-bar"></div>

  <article class="container-reading" itemscope itemtype="https://schema.org/NewsArticle">
    <header class="article-header">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li>
            <a href="/">Home</a>
            <span class="breadcrumb-sep">/</span>
          </li>
          <li>
            <a href={`/category/${category}`}>
              {categoryLabel[category] || category}
            </a>
            <span class="breadcrumb-sep">/</span>
          </li>
          <li>
            <span class="breadcrumb-current" aria-current="page">{title}</span>
          </li>
        </ol>
      </nav>

      <div class="article-kicker">
        <a href={`/category/${category}`}>
          {categoryLabel[category] || category}
        </a>
        <span>·</span>
        <time datetime={pubDate.toISOString()} itemprop="datePublished">{formattedDate}</time>
        <span>·</span>
        <span>{readingTime}</span>
      </div>

      <h1 class="article-headline" itemprop="headline">{title}</h1>
      <p class="article-deck" itemprop="description">{subtitle}</p>

      <div class="article-byline-bar">
        <div class="byline-author-block" itemprop="author" itemscope itemtype="https://schema.org/Person">
          <span class="byline-author-name" itemprop="name">{author.name}</span>
          <span class="byline-author-role">
            <span itemprop="jobTitle">{author.role}</span> · {readingTime}
          </span>
        </div>

        <div class="byline-actions">
          <a
            href={xShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="byline-icon-btn"
            data-share-method="x"
            title="Share on X (Twitter)"
            aria-label="Share on X (Twitter)"
          >
            X
          </a>

          <a
            href={hnShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="byline-icon-btn"
            data-share-method="hackernews"
            title="Submit to Hacker News"
            aria-label="Submit to Hacker News"
          >
            HN
          </a>

          <a
            href={linkedinShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="byline-icon-btn"
            data-share-method="linkedin"
            title="Share on LinkedIn"
            aria-label="Share on LinkedIn"
          >
            in
          </a>

          <button
            type="button"
            class="byline-icon-btn"
            id="font-size-cycle-btn"
            title="Cycle reading font size"
            aria-label="Cycle reading font size"
          >
            Aa
          </button>

          <button
            type="button"
            class="byline-icon-btn"
            data-bookmark-slug={article.slug}
            title="Save to reading list"
            aria-label="Bookmark article"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
            </svg>
          </button>

          <button
            type="button"
            class="byline-icon-btn"
            id="copy-link-btn"
            title="Copy article link"
            aria-label="Copy article link"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
            </svg>
          </button>
        </div>
      </div>

      {coverImage && (
        <figure class="article-cover-figure">
          <img
            src={coverImage}
            alt={coverAlt || title}
            width="1200"
            height="675"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="article-cover-img"
            itemprop="image"
          />
          {coverCaption && (
            <figcaption class="article-cover-caption">{coverCaption}</figcaption>
          )}
        </figure>
      )}
    </header>

    <!-- Editorial Abstract Frame (The Brief — Hairline Top/Bottom, No Side-Stripe) -->
    {tldr && tldr.length > 0 && (
      <aside class="editorial-brief" aria-label="The Brief">
        <div class="editorial-brief-label">The Brief</div>
        <ul>
          {tldr.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </aside>
    )}

    <!-- Compact Technical Advisory Metadata (for CVE / Security Articles) -->
    {cveIds && cveIds.length > 0 && (
      <section class="spec-datasheet" aria-label="Vulnerability Specification">
        <div class="spec-row">
          <div class="spec-key">Identifier</div>
          <div class="spec-val">
            {cveIds.map((id, idx) => (
              <>
                <a href={`/cve/${toCveSlug(id)}`} class="spec-cve-link" title={`View ${id} advisory datasheet`}>
                  {id}
                </a>
                {idx < cveIds.length - 1 ? ', ' : ''}
              </>
            ))}
          </div>
        </div>
        {(severity || cvss) && (
          <div class="spec-row">
            <div class="spec-key">Severity</div>
            <div class={`spec-val ${severity ? `severity-${severity}` : ''}`} style="font-weight:500;">
              {severity || 'ADVISORY'}{cvss ? ` · CVSS ${cvss}` : ''}
            </div>
          </div>
        )}
        {affectedVersions && (
          <div class="spec-row">
            <div class="spec-key">Affected</div>
            <div class="spec-val">{affectedVersions}</div>
          </div>
        )}
        {patchedVersions && (
          <div class="spec-row">
            <div class="spec-key">Patched</div>
            <div class="spec-val">{patchedVersions}</div>
          </div>
        )}
      </section>
    )}

    <!-- Main Essay Body (Medium 20px Serif, 1.8 line-height, 680px measure) -->
    <div class="prose-editorial" itemprop="articleBody">
      <Content />
    </div>

    <!-- Topic Tags -->
    <div class="topic-pills-wrap" style="margin-top:44px;">
      {tags.map((tag) => (
        <a href={`/?tag=${encodeURIComponent(tag)}`} class="topic-pill">
          {tag}
        </a>
      ))}
    </div>

    <!-- Footnote-style Primary Sources -->
    {sources && sources.length > 0 && (
      <section class="sources-block">
        <h2 class="sources-heading">Sources &amp; Primary Advisories</h2>
        <ol class="sources-list">
          {sources.map((src) => (
            <li>
              <a
                href={src.url}
                target="_blank"
                rel="noopener noreferrer"
                class="source-link"
              >
                {src.label}
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- Editorial Share Bar (X, Hacker News, LinkedIn, Copy Link) -->
    <div class="article-share-bar" aria-label="Share this dispatch">
      <span class="article-share-label">Share Dispatch</span>
      <div class="article-share-actions">
        <a
          href={xShareUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="share-pill-btn"
          data-share-method="x"
        >
          <span>Post on X</span>
        </a>
        <a
          href={hnShareUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="share-pill-btn"
          data-share-method="hackernews"
        >
          <span>Hacker News</span>
        </a>
        <a
          href={linkedinShareUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="share-pill-btn"
          data-share-method="linkedin"
        >
          <span>LinkedIn</span>
        </a>
        <button
          type="button"
          class="share-pill-btn"
          id="footer-copy-link-btn"
        >
          <span>Copy Link</span>
        </button>
      </div>
    </div>

    <!-- Print-Styled RSS & CVE Syndication Callout Box -->
    <aside class="syndication-box" aria-label="Follow TechPulse Dispatches">
      <div class="editorial-brief-label">Syndication &amp; Feeds</div>
      <h2 class="syndication-title">Follow TechPulse Dispatches</h2>
      <p class="syndication-desc">
        Receive new systems engineering analyses, frontier AI evaluations, and emergency CVE advisories in Feedly, Inoreader, NetNewsWire, or your team’s Slack/Discord RSS integration.
      </p>
      <div class="syndication-actions">
        <a href="/rss.xml" class="syndication-btn-primary" data-share-method="rss_feed">
          <span>RSS 2.0 Feed (/rss.xml)</span>
        </a>
        <button type="button" class="syndication-btn-secondary" id="copy-rss-url-btn">
          <span>Copy RSS URL</span>
        </button>
        <a href="/security" class="syndication-btn-secondary">
          <span>CVE Advisory Index →</span>
        </a>
      </div>
    </aside>

    <!-- Previous / Next Dispatch Internal Linking -->
    {(olderArticle || newerArticle) && (
      <nav class="article-prev-next" aria-label="Adjacent dispatches">
        <div>
          {olderArticle && (
            <a href={`/articles/${olderArticle.slug}`} class="prev-next-card prev-card">
              <span class="prev-next-label">← Previous Dispatch</span>
              <span class="prev-next-title">{olderArticle.data.title}</span>
            </a>
          )}
        </div>
        <div>
          {newerArticle && (
            <a href={`/articles/${newerArticle.slug}`} class="prev-next-card next-card">
              <span class="prev-next-label">Next Dispatch →</span>
              <span class="prev-next-title">{newerArticle.data.title}</span>
            </a>
          )}
        </div>
      </nav>
    )}

    <!-- Further Reading -->
    {relatedArticles.length > 0 && (
      <section class="related-section">
        <h2 class="sources-heading" style="margin-bottom:4px;">
          More in {categoryLabel[category] || category}
        </h2>
        <div>
          {relatedArticles.map((rel) => (
            <ArticleCard article={rel} />
          ))}
        </div>
      </section>
    )}
  </article>

  <script is:inline define:vars={{ slug: article.slug, category, siteOrigin: SITE }}>
    (function () {
      var bar = document.getElementById('reading-progress-bar');
      var milestones = { 25: false, 50: false, 75: false, 100: false };

      window.addEventListener(
        'scroll',
        function () {
          if (!bar) return;
          var docHeight =
            document.documentElement.scrollHeight -
            document.documentElement.clientHeight;
          var pct = docHeight > 0 ? (window.scrollY / docHeight) * 100 : 0;
          var clamped = Math.min(100, Math.max(0, pct));
          bar.style.width = clamped + '%';

          [25, 50, 75, 100].forEach(function (m) {
            if (!milestones[m] && clamped >= m - 2) {
              milestones[m] = true;
              if (window.tpTrack) {
                window.tpTrack('article_read_depth', {
                  article_slug: slug,
                  category: category,
                  percent_scrolled: m,
                });
              }
            }
          });
        },
        { passive: true }
      );

      var sizes = ['1.125rem', '1.25rem', '1.375rem'];
      var fontBtn = document.getElementById('font-size-cycle-btn');
      if (fontBtn) {
        fontBtn.addEventListener('click', function () {
          var current =
            document.documentElement.style.getPropertyValue('--article-font-size') ||
            '1.25rem';
          var idx = sizes.indexOf(current.trim());
          var next = sizes[(idx + 1) % sizes.length];
          document.documentElement.style.setProperty('--article-font-size', next);
          try {
            localStorage.setItem('techpulse-font-size', next);
          } catch (e) {}
        });
      }

      function handleCopyLink(btnEl, restoreHtml) {
        if (!btnEl || !navigator.clipboard) return;
        navigator.clipboard.writeText(window.location.href);
        var orig = restoreHtml || btnEl.innerHTML;
        btnEl.textContent = '✓ Copied';
        setTimeout(function () {
          btnEl.innerHTML = orig;
        }, 1400);
        if (window.tpTrack) {
          window.tpTrack('article_share', { method: 'copy_link', slug: slug });
        }
      }

      var copyBtn = document.getElementById('copy-link-btn');
      if (copyBtn) {
        var origTopHtml = copyBtn.innerHTML;
        copyBtn.addEventListener('click', function () {
          if (navigator.clipboard) {
            navigator.clipboard.writeText(window.location.href);
            copyBtn.textContent = '✓';
            setTimeout(function () {
              copyBtn.innerHTML = origTopHtml;
            }, 1400);
            if (window.tpTrack) {
              window.tpTrack('article_share', { method: 'copy_link', slug: slug });
            }
          }
        });
      }

      var footerCopyBtn = document.getElementById('footer-copy-link-btn');
      if (footerCopyBtn) {
        var origFooterHtml = footerCopyBtn.innerHTML;
        footerCopyBtn.addEventListener('click', function () {
          handleCopyLink(footerCopyBtn, origFooterHtml);
        });
      }

      var copyRssBtn = document.getElementById('copy-rss-url-btn');
      if (copyRssBtn) {
        var origRssHtml = copyRssBtn.innerHTML;
        copyRssBtn.addEventListener('click', function () {
          if (navigator.clipboard) {
            navigator.clipboard.writeText(siteOrigin + '/rss.xml');
            copyRssBtn.textContent = '✓ RSS URL Copied';
            setTimeout(function () {
              copyRssBtn.innerHTML = origRssHtml;
            }, 1500);
            if (window.tpTrack) {
              window.tpTrack('article_share', { method: 'copy_rss_url', slug: slug });
            }
          }
        });
      }

      document.querySelectorAll('[data-share-method]').forEach(function (el) {
        el.addEventListener('click', function () {
          var method = el.getAttribute('data-share-method') || 'unknown';
          if (window.tpTrack) {
            window.tpTrack('article_share', { method: method, slug: slug });
          }
        });
      });

      document.querySelectorAll('.source-link').forEach(function (link) {
        link.addEventListener('click', function () {
          if (window.tpTrack) {
            window.tpTrack('outbound_source_click', {
              article_slug: slug,
              destination_url: link.getAttribute('href') || '',
            });
          }
        });
      });
    })();
  </script>
</BaseLayout>
