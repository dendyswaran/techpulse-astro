---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';

const allArticles = (await getCollection('articles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const advisoryLedger = [
  {
    id: 'CVE-2026-111497',
    label: 'Node.js Brotli RCE',
    cvss: '9.8',
    severity: 'CRITICAL',
    slug: 'nodejs-october-2026-brotli-rce-cve-2026-111497',
  },
  {
    id: 'CVE-2026-109618',
    label: 'PHP SAPI Pre-Auth RCE',
    cvss: '9.2',
    severity: 'CRITICAL',
    slug: 'php2shell-rce-cve-2026-109618-ditemukan-ai',
  },
  {
    id: 'GHSA-cf8x-9m69',
    label: 'Bun HTTP/3 QPACK DoS',
    cvss: '9.2',
    severity: 'HIGH',
    slug: 'bun-v1-4-4-http3-qpack-brotli-emudhra-security',
  },
  {
    id: 'CVE-2026-91403',
    label: 'Oracle Java JSSE TLS',
    cvss: '9.1',
    severity: 'CRITICAL',
    slug: 'oracle-java-jsse-cve-2026-91403-out-of-band-alert',
  },
];

const staffPicks = allArticles.filter((a) => a.data.featured).slice(0, 4);

const categoryLabel: Record<string, string> = {
  ai: 'AI',
  security: 'Security',
  'tech-update': 'Systems',
  'tech-news': 'Industry',
};

const popularTopics = [
  'Node.js',
  'Bun',
  'PHP',
  'Java',
  'AI Agents',
  'LLM',
  'Astro',
  'Zero-Day',
  'TLS',
  'RCE',
];
---

<BaseLayout
  title="TechPulse — Systems, AI & Security Advisories"
  activeNav="home"
  ogImage={allArticles[0]?.data.coverImage}
>
  <div class="container-wide">
    <div class="medium-grid">
      <!-- Left Column (680px): Borderless Tab Strip + Typographic Stream -->
      <div class="main-stream">
        <div class="category-tabs" role="tablist" aria-label="Filter by Section">
          <button type="button" class="cat-tab active" data-filter-cat="all">
            All
          </button>
          <button type="button" class="cat-tab" data-filter-cat="ai">
            AI
          </button>
          <button type="button" class="cat-tab" data-filter-cat="security">
            Security
          </button>
          <button type="button" class="cat-tab" data-filter-cat="tech-update">
            Systems
          </button>
          <button type="button" class="cat-tab" data-filter-cat="tech-news">
            Industry
          </button>
          <a href="/security" class="cat-tab" style="margin-left:auto;">
            CVE Index
          </a>
        </div>

        <div
          id="active-tag-banner"
          style="display:none; padding:14px 0; border-bottom:1px solid var(--hairline); font-size:0.8125rem; color:var(--ink-muted); align-items:center; justify-content:space-between;"
        >
          <span>Topic: <strong id="active-tag-name" style="color:var(--ink); font-weight:500;"></strong></span>
          <button
            type="button"
            id="clear-tag-filter"
            style="background:none; border:none; color:var(--ink); font-size:0.8125rem; cursor:pointer; padding:0; text-decoration:underline; text-underline-offset:3px;"
          >
            Clear
          </button>
        </div>

        <div id="articles-feed">
          {allArticles.map((article, index) => (
            <ArticleCard article={article} lead={index === 0} />
          ))}
        </div>
      </div>

      <!-- Right Sidebar (Separated by a single 1px vertical hairline, zero boxed cards) -->
      <aside class="right-sidebar" aria-label="Editorial Rail">
        <div class="sidebar-sticky">
          <!-- Section 1: Active Advisories (Minimalist Ledger) -->
          <section class="sidebar-section">
            <h2 class="sidebar-heading">
              <span>Active Advisories</span>
              <a href="/security" class="sidebar-heading-link">Index</a>
            </h2>
            <div class="advisory-ledger">
              {advisoryLedger.map((item) => (
                <a href={`/articles/${item.slug}`} class="advisory-ledger-row">
                  <span class="ledger-id">{item.id}</span>
                  <span class="ledger-title">{item.label}</span>
                  <span class={`ledger-score severity-${item.severity}`}>{item.cvss}</span>
                </a>
              ))}
            </div>
          </section>

          <!-- Section 2: Week in Brief (Medium Staff Picks Style) -->
          <section class="sidebar-section">
            <h2 class="sidebar-heading">
              <span>Week in Brief</span>
            </h2>
            <div>
              {staffPicks.map((pick) => (
                <a href={`/articles/${pick.slug}`} class="staff-pick-item">
                  <div class="staff-pick-kicker">
                    <strong>{pick.data.author.name}</strong> in <strong>{categoryLabel[pick.data.category] || pick.data.category}</strong>
                  </div>
                  <h3 class="staff-pick-title">{pick.data.title}</h3>
                </a>
              ))}
            </div>
          </section>

          <!-- Section 3: Topics (Medium Muted Pills) -->
          <section class="sidebar-section">
            <h2 class="sidebar-heading">
              <span>Topics</span>
            </h2>
            <div class="topic-pills-wrap">
              {popularTopics.map((topic) => (
                <button
                  type="button"
                  class="topic-pill"
                  data-topic-chip={topic.toLowerCase()}
                >
                  {topic}
                </button>
              ))}
            </div>
          </section>

          <!-- Section 4: Reading List -->
          <section class="sidebar-section" style="margin-bottom:0;">
            <h2 class="sidebar-heading">
              <span>Reading List</span>
            </h2>
            <div id="sidebar-bookmarks-list"></div>
          </section>
        </div>
      </aside>
    </div>
  </div>

  <script is:inline>
    (function () {
      var tabs = document.querySelectorAll('[data-filter-cat]');
      var cards = document.querySelectorAll('#articles-feed .story-card');
      var topicChips = document.querySelectorAll('[data-topic-chip]');
      var tagBanner = document.getElementById('active-tag-banner');
      var tagNameEl = document.getElementById('active-tag-name');
      var clearTagBtn = document.getElementById('clear-tag-filter');

      var activeCat = 'all';
      var activeTag = '';

      function applyFilter() {
        var firstVisibleFound = false;
        cards.forEach(function (card) {
          var cardCat = card.getAttribute('data-category');
          var cardTags = card.getAttribute('data-tags') || '';
          var catMatch = activeCat === 'all' || cardCat === activeCat;
          var tagMatch = !activeTag || cardTags.indexOf(activeTag) !== -1;
          var visible = catMatch && tagMatch;
          card.style.display = visible ? 'block' : 'none';
          if (visible && !firstVisibleFound) {
            card.classList.add('story-card-lead');
            firstVisibleFound = true;
          } else {
            card.classList.remove('story-card-lead');
          }
        });

        topicChips.forEach(function (chip) {
          var t = chip.getAttribute('data-topic-chip') || '';
          chip.classList.toggle('active', activeTag === t && activeTag !== '');
        });

        if (tagBanner && tagNameEl) {
          if (activeTag) {
            tagBanner.style.display = 'flex';
            tagNameEl.textContent = activeTag;
          } else {
            tagBanner.style.display = 'none';
          }
        }
      }

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          activeCat = tab.getAttribute('data-filter-cat') || 'all';
          tabs.forEach(function (t) {
            t.classList.toggle('active', t === tab);
          });
          applyFilter();
        });
      });

      topicChips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          var t = chip.getAttribute('data-topic-chip') || '';
          activeTag = activeTag === t ? '' : t;
          applyFilter();
        });
      });

      if (clearTagBtn) {
        clearTagBtn.addEventListener('click', function () {
          activeTag = '';
          applyFilter();
        });
      }
    })();
  </script>
</BaseLayout>
