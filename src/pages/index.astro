---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { CURATED_CVE_RECORDS } from '../data/cves';
import { AI_MODELS } from '../data/models';

const SITE = 'https://www.techpulsenews.tech';

const allArticles = (await getCollection('articles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const advisoryLedger = CURATED_CVE_RECORDS.slice(0, 7);
const modelLedger = AI_MODELS.slice(0, 6);

const staffPicks = allArticles.filter((a) => a.data.featured).slice(0, 4);

const categoryLabel: Record<string, string> = {
  ai: 'AI',
  security: 'Security',
  'tech-update': 'Systems',
  'tech-news': 'Industry',
};

const popularTopics = [
  'Node.js',
  'Bun',
  'PHP',
  'Java',
  'UEFI',
  'Veeam',
  'Anthropic',
  'AI Agents',
  'LLM',
  'Astro',
  'Zero-Day',
  'RCE',
];

const homeCollectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE}/#collection`,
  name: 'TechPulse — Systems, AI & Security Advisories',
  description:
    'Independent engineering reporting on software systems, foundation models, and runtime security advisories (CVEs) across Node.js, Bun, PHP, Java SE, UEFI, Veeam, and AI infrastructure.',
  url: `${SITE}/`,
  isPartOf: { '@id': `${SITE}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: allArticles.length,
    itemListElement: allArticles.map((entry, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      url: `${SITE}/articles/${entry.slug}`,
      name: entry.data.title,
    })),
  },
};
---

<BaseLayout
  title="TechPulse — Systems, AI & Security Advisories"
  description="Independent engineering reporting on software systems, foundation models, and runtime security advisories (CVEs) across Node.js, Bun, PHP, Java SE, UEFI, Veeam, and AI infrastructure."
  activeNav="home"
  canonicalPath="/"
  ogImage={allArticles[0]?.data.coverImage}
  ogImageAlt={allArticles[0]?.data.coverAlt || allArticles[0]?.data.title}
  preloadImage={allArticles[0]?.data.coverImage}
  jsonLd={homeCollectionSchema}
>
  <div class="container-wide">
    <h1 class="sr-only">
      TechPulse — Systems, AI &amp; Security Advisories
    </h1>

    <div class="medium-grid">
      <!-- Left Column (680px): Borderless Tab Strip + Typographic Stream -->
      <div class="main-stream">
        <div class="category-tabs" role="tablist" aria-label="Filter by Section">
          <button type="button" role="tab" aria-selected="true" class="cat-tab active" data-filter-cat="all">
            All
          </button>
          <button type="button" role="tab" aria-selected="false" class="cat-tab" data-filter-cat="ai">
            AI
          </button>
          <button type="button" role="tab" aria-selected="false" class="cat-tab" data-filter-cat="security">
            Security
          </button>
          <button type="button" role="tab" aria-selected="false" class="cat-tab" data-filter-cat="tech-update">
            Systems
          </button>
          <button type="button" role="tab" aria-selected="false" class="cat-tab" data-filter-cat="tech-news">
            Industry
          </button>
          <a href="/models" class="cat-tab cat-tab-right">
            Models &amp; VRAM
          </a>
          <a href="/security" class="cat-tab">
            CVE Index
          </a>
        </div>

        <div id="active-tag-banner" class="tag-filter-banner">
          <span>Topic: <strong id="active-tag-name" style="color:var(--ink); font-weight:500;"></strong></span>
          <button type="button" id="clear-tag-filter" class="tag-filter-clear">
            Clear
          </button>
        </div>

        <div id="articles-feed">
          {allArticles.map((article, index) => (
            <ArticleCard article={article} lead={index === 0} />
          ))}
        </div>
      </div>

      <!-- Right Sidebar (Separated by a single 1px vertical hairline, zero boxed cards) -->
      <aside class="right-sidebar" aria-label="Editorial Rail">
        <div class="sidebar-sticky">
          <!-- Section 1: Active Advisories (Minimalist Ledger linking to /cve/[id]) -->
          <section class="sidebar-section">
            <h2 class="sidebar-heading">
              <span>Active Advisories</span>
              <a href="/security" class="sidebar-heading-link">Full Index →</a>
            </h2>
            <div class="advisory-ledger">
              {advisoryLedger.map((item) => (
                <a href={`/cve/${item.slugId}`} class="advisory-ledger-row" title={`${item.id} — ${item.component}`}>
                  <span class="ledger-id">{item.id}</span>
                  <span class="ledger-title">{item.shortLabel}</span>
                  <span class={`ledger-score severity-${item.severity}`}>{item.cvss}</span>
                </a>
              ))}
            </div>
          </section>

          <!-- Section 1B: AI Model Pricing & GPU VRAM Calculator Ledger -->
          <section class="sidebar-section">
            <h2 class="sidebar-heading">
              <span>Models &amp; GPU VRAM</span>
              <a href="/models" class="sidebar-heading-link">Calculator →</a>
            </h2>
            <div class="advisory-ledger">
              {modelLedger.map((m) => (
                <a href={`/models/${m.id}`} class="advisory-ledger-row" title={`${m.name} (${m.contextLabel})`}>
                  <span class="ledger-id">{m.shortName}</span>
                  <span class="ledger-title">{m.contextLabel.replace(' tokens', '')}</span>
                  <span class="ledger-score">${m.inputPricePer1M.toFixed(2)}</span>
                </a>
              ))}
            </div>
          </section>

          <!-- Section 2: Week in Brief (Medium Staff Picks Style) -->
          <section class="sidebar-section">
            <h2 class="sidebar-heading">
              <span>Week in Brief</span>
            </h2>
            <div>
              {staffPicks.map((pick) => (
                <a href={`/articles/${pick.slug}`} class="staff-pick-item">
                  <div class="staff-pick-kicker">
                    <strong>{pick.data.author.name}</strong> in <strong>{categoryLabel[pick.data.category] || pick.data.category}</strong>
                  </div>
                  <h3 class="staff-pick-title">{pick.data.title}</h3>
                </a>
              ))}
            </div>
          </section>

          <!-- Section 3: Topics (Medium Muted Pills) -->
          <section class="sidebar-section">
            <h2 class="sidebar-heading">
              <span>Topics</span>
            </h2>
            <div class="topic-pills-wrap">
              {popularTopics.map((topic) => (
                <button
                  type="button"
                  class="topic-pill"
                  data-topic-chip={topic.toLowerCase()}
                >
                  {topic}
                </button>
              ))}
            </div>
          </section>

          <!-- Section 4: Reading List -->
          <section class="sidebar-section">
            <h2 class="sidebar-heading">
              <span>Reading List</span>
            </h2>
            <div id="sidebar-bookmarks-list"></div>
          </section>
        </div>
      </aside>
    </div>
  </div>

  <script is:inline>
    (function () {
      var tabs = document.querySelectorAll('[data-filter-cat]');
      var cards = document.querySelectorAll('#articles-feed .story-card');
      var topicChips = document.querySelectorAll('[data-topic-chip]');
      var tagBanner = document.getElementById('active-tag-banner');
      var tagNameEl = document.getElementById('active-tag-name');
      var clearTagBtn = document.getElementById('clear-tag-filter');

      var activeCat = 'all';
      var activeTag = '';

      function applyFilter() {
        var firstVisibleFound = false;
        cards.forEach(function (card) {
          var cardCat = card.getAttribute('data-category');
          var cardTags = card.getAttribute('data-tags') || '';
          var catMatch = activeCat === 'all' || cardCat === activeCat;
          var tagMatch = !activeTag || cardTags.indexOf(activeTag) !== -1;
          var visible = catMatch && tagMatch;
          card.style.display = visible ? 'block' : 'none';
          if (visible && !firstVisibleFound) {
            card.classList.add('story-card-lead');
            firstVisibleFound = true;
          } else {
            card.classList.remove('story-card-lead');
          }
        });

        topicChips.forEach(function (chip) {
          var t = chip.getAttribute('data-topic-chip') || '';
          var isChipActive = activeTag === t && activeTag !== '';
          chip.classList.toggle('active', isChipActive);
          chip.setAttribute('aria-pressed', isChipActive ? 'true' : 'false');
        });

        if (tagBanner && tagNameEl) {
          if (activeTag) {
            tagBanner.style.display = 'flex';
            tagNameEl.textContent = activeTag;
          } else {
            tagBanner.style.display = 'none';
          }
        }
      }

      // Check initial ?tag= URL parameter
      try {
        var params = new URLSearchParams(window.location.search);
        var urlTag = params.get('tag');
        if (urlTag) {
          activeTag = urlTag.toLowerCase();
          applyFilter();
        }
      } catch (e) {}

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          activeCat = tab.getAttribute('data-filter-cat') || 'all';
          tabs.forEach(function (t) {
            var isSel = t === tab;
            t.classList.toggle('active', isSel);
            t.setAttribute('aria-selected', isSel ? 'true' : 'false');
          });
          applyFilter();
          if (window.tpTrack) {
            window.tpTrack('category_filter', { category: activeCat });
          }
        });
      });

      topicChips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          var t = chip.getAttribute('data-topic-chip') || '';
          activeTag = activeTag === t ? '' : t;
          applyFilter();
          if (window.tpTrack && activeTag) {
            window.tpTrack('topic_filter', { topic: activeTag });
          }
        });
      });

      if (clearTagBtn) {
        clearTagBtn.addEventListener('click', function () {
          activeTag = '';
          applyFilter();
        });
      }
    })();
  </script>
</BaseLayout>
