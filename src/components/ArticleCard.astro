---
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const {
  title,
  subtitle,
  pubDate,
  category,
  tags,
  readingTime,
  author,
  cveIds,
  severity,
  cvss,
} = article.data;

const categoryLabel: Record<string, string> = {
  ai: 'AI',
  security: 'Security',
  'tech-update': 'Systems',
  'tech-news': 'Industry',
};

const formattedDate = pubDate.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
});

const primaryTopic = tags && tags.length > 0 ? tags[0] : null;
const primaryCve = cveIds && cveIds.length > 0 ? cveIds[0] : null;
---

<article
  class="story-card"
  data-category={category}
  data-tags={tags.join(',').toLowerCase()}
>
  <div class="story-kicker">
    <span class="kicker-author">{author.name}</span>
    <span>in</span>
    <a href={`/category/${category}`} class="kicker-cat">
      {categoryLabel[category] || category}
    </a>
    <span>·</span>
    <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    {primaryCve && (
      <>
        <span>·</span>
        <span class={`kicker-cve ${severity ? `severity-${severity}` : ''}`}>
          {primaryCve}{cvss ? ` · ${cvss}` : ''}
        </span>
      </>
    )}
  </div>

  <a href={`/articles/${article.slug}`} style="display: block;">
    <h2 class="story-title">{title}</h2>
    <p class="story-subtitle">{subtitle}</p>
  </a>

  <div class="story-footer">
    <div class="story-footer-meta">
      {primaryTopic && <span class="story-topic-pill">{primaryTopic}</span>}
      <span>{readingTime}</span>
    </div>

    <button
      type="button"
      class="bookmark-icon-btn"
      data-bookmark-slug={article.slug}
      aria-label={`Bookmark ${title}`}
      title="Save to reading list"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
      </svg>
    </button>
  </div>
</article>
