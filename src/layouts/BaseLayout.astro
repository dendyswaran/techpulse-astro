---
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  activeNav?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  preloadImage?: string;
  canonicalPath?: string;
  publishedTime?: string;
  modifiedTime?: string;
  authorName?: string;
  section?: string;
  tags?: string[];
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
  title = 'TechPulse — Systems, AI & Security Advisories',
  description = 'Independent engineering reporting on software systems, foundation models, and runtime security advisories across Node.js, Bun, PHP, Java SE, and AI infrastructure.',
  activeNav = 'home',
  ogImage = '/images/covers/openai-gpt-6-1-terra-mirendil-fern-10m-context.webp',
  ogImageAlt = 'TechPulse editorial illustration',
  ogType = 'website',
  preloadImage,
  canonicalPath,
  publishedTime,
  modifiedTime,
  authorName = 'Mazzden',
  section,
  tags = [],
  jsonLd,
} = Astro.props;

const siteOrigin = 'https://www.techpulsenews.tech';
const rawPath = canonicalPath ?? Astro.url.pathname;
const normalizedPath =
  rawPath === '/' ? '/' : rawPath.replace(/\/+$/, '');
const canonicalURL = `${siteOrigin}${normalizedPath}`;

const resolvedOgImage = ogImage
  ? ogImage.startsWith('http')
    ? ogImage
    : `${siteOrigin}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`
  : `${siteOrigin}/images/covers/openai-gpt-6-1-terra-mirendil-fern-10m-context.webp`;

const gaId =
  import.meta.env.PUBLIC_GA_MEASUREMENT_ID ||
  import.meta.env.PUBLIC_GA_ID ||
  'G-F5D4ZWZ1TG';

const googleFontsUrl =
  'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400&family=Plus+Jakarta+Sans:wght@600;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&display=swap';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'NewsMediaOrganization',
  '@id': `${siteOrigin}/#organization`,
  name: 'TechPulse',
  url: `${siteOrigin}/`,
  logo: {
    '@type': 'ImageObject',
    url: `${siteOrigin}/favicon.svg`,
    width: 512,
    height: 512,
  },
  description:
    'Independent engineering publication covering software systems, frontier AI models, and runtime security advisories (CVEs).',
  publishingPrinciples: `${siteOrigin}/security`,
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteOrigin}/#website`,
  url: `${siteOrigin}/`,
  name: 'TechPulse',
  description:
    'Systems, AI & Security Advisories — Independent reporting on software runtimes, foundation models, and CVE disclosures.',
  publisher: {
    '@id': `${siteOrigin}/#organization`,
  },
  inLanguage: 'en-US',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteOrigin}/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

const extraSchemas = Array.isArray(jsonLd)
  ? jsonLd
  : jsonLd
    ? [jsonLd]
    : [];

const allSchemas = [organizationSchema, websiteSchema, ...extraSchemas];

const allArticles = await getCollection('articles');
const searchIndex = allArticles
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((entry) => ({
    slug: entry.slug,
    title: entry.data.title,
    subtitle: entry.data.subtitle,
    category: entry.data.category,
    author: entry.data.author.name,
    tags: entry.data.tags,
    cveIds: entry.data.cveIds || [],
    severity: entry.data.severity || null,
    cvss: entry.data.cvss || null,
    readingTime: entry.data.readingTime,
  }));
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={authorName} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta
      name="googlebot"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <link rel="canonical" href={canonicalURL} />

    <!-- Sitemap, RSS & Web Manifest Discovery -->
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="TechPulse — Systems, AI & Security Advisories RSS Feed"
      href={`${siteOrigin}/rss.xml`}
    />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#FFFFFF" />

    <!-- Core Web Vitals: Preconnect & Non-Render-Blocking Font Loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {gaId && <link rel="preconnect" href="https://www.googletagmanager.com" />}
    <link rel="preload" as="style" href={googleFontsUrl} />
    <link
      rel="stylesheet"
      href={googleFontsUrl}
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href={googleFontsUrl} />
    </noscript>

    <!-- Core Web Vitals: Preload LCP Hero / Lead Image -->
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage}
        type="image/webp"
        fetchpriority="high"
      />
    )}

    <!-- Open Graph Metadata -->
    <meta property="og:site_name" content="TechPulse" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:alt" content={ogImageAlt} />

    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {ogType === 'article' && authorName && (
      <meta property="article:author" content={authorName} />
    )}
    {ogType === 'article' && section && (
      <meta property="article:section" content={section} />
    )}
    {ogType === 'article' &&
      tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter / X Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Rich JSON-LD Structured Data (Schema.org) -->
    {allSchemas.map((schemaObj) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schemaObj)}
      />
    ))}

    <!-- Google Analytics 4 (GA4 / gtag.js) -->
    <meta name="ga-measurement-id" content={gaId} />
    {gaId && (
      <script
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
      ></script>
    )}
    <script is:inline define:vars={{ gaId }}>
      (function () {
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }
        window.gtag = gtag;

        var activeGaId = gaId;
        try {
          if (!activeGaId) {
            activeGaId = localStorage.getItem('techpulse-ga-id') || '';
          }
        } catch (e) {}

        if (activeGaId) {
          if (!document.querySelector('script[src*="googletagmanager.com/gtag/js"]')) {
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(activeGaId);
            document.head.appendChild(s);
          }
          gtag('js', new Date());
          gtag('config', activeGaId, {
            page_path: window.location.pathname,
            page_title: document.title,
            anonymize_ip: true,
          });
        }

        window.tpTrack = function (eventName, params) {
          if (typeof window.gtag === 'function' && activeGaId) {
            window.gtag('event', eventName, params || {});
          }
        };
      })();
    </script>

    <!-- Instant Theme & Reading Font Size Restoration -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('techpulse-theme') || 'light';
          document.documentElement.setAttribute('data-theme', saved);
          var savedFont = localStorage.getItem('techpulse-font-size');
          if (savedFont) {
            document.documentElement.style.setProperty('--article-font-size', savedFont);
          }
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand-wordmark" aria-label="TechPulse Home">TechPulse</a>

        <nav class="header-utilities" aria-label="Primary Utilities">
          <button type="button" class="util-btn" id="open-search-btn" aria-label="Search stories and CVEs">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <circle cx="11" cy="11" r="7.5"></circle>
              <line x1="20" y1="20" x2="16.2" y2="16.2"></line>
            </svg>
            <span>Search</span>
          </button>

          <a
            href="/tips"
            class:list={['util-link', { active: activeNav === 'tips' }]}
            aria-current={activeNav === 'tips' ? 'page' : undefined}
          >
            Tips
          </a>

          <a
            href="/models"
            class:list={['util-link', { active: activeNav === 'models' }]}
            aria-current={activeNav === 'models' ? 'page' : undefined}
          >
            Models<span class="util-link-extra">&amp; VRAM</span>
          </a>

          <a
            href="/security"
            class:list={['util-link', { active: activeNav === 'cve-matrix' }]}
            aria-current={activeNav === 'cve-matrix' ? 'page' : undefined}
          >
            CVEs
          </a>

          <button type="button" class="util-btn" id="cycle-theme-btn" aria-label="Cycle reading theme" title="Switch reading theme">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <circle cx="12" cy="12" r="4.5"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
            </svg>
            <span id="theme-label">Paper</span>
          </button>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <!-- Search Modal -->
    <div class="search-backdrop" id="search-backdrop" role="dialog" aria-modal="true" aria-label="Search">
      <div class="search-modal">
        <div class="search-input-wrap">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" style="color: var(--ink-muted)">
            <circle cx="11" cy="11" r="7.5"></circle>
            <line x1="20" y1="20" x2="16.2" y2="16.2"></line>
          </svg>
          <input
            type="search"
            id="global-search-input"
            class="search-input"
            placeholder="Search stories, authors, or CVE identifiers..."
            aria-label="Search stories, authors, or CVE identifiers"
            autocomplete="off"
          />
          <button type="button" id="close-search-btn" class="util-btn" aria-label="Close search">Esc</button>
        </div>
        <div class="search-results" id="global-search-results"></div>
      </div>
    </div>

    <footer class="site-footer">
      <div class="container-wide footer-inner">
        <div>
          <span class="font-serif" style="font-weight:600; color:var(--ink);">TechPulse</span>
          <span style="margin-left:10px;">Systems, AI &amp; Security Advisories</span>
        </div>
        <nav aria-label="Footer Navigation" class="footer-nav">
          <a href="/" class="util-link">Archive</a>
          <a href="/category/ai" class="util-link">AI</a>
          <a href="/category/security" class="util-link">Security</a>
          <a href="/category/tech-update" class="util-link">Systems</a>
          <a href="/category/tech-news" class="util-link">Industry</a>
          <a href="/tips" class="util-link">Tips</a>
          <a href="/models" class="util-link">Models &amp; VRAM</a>
          <a href="/security" class="util-link">CVE Index</a>
          <a href="/rss.xml" class="util-link">RSS</a>
          <a href="/sitemap.xml" class="util-link">Sitemap</a>
        </nav>
      </div>
    </footer>

    <script is:inline define:vars={{ searchIndex }}>
      (function () {
        var themes = ['light', 'sepia', 'dark'];
        var labels = { light: 'Paper', sepia: 'Sepia', dark: 'Night' };
        var themeBtn = document.getElementById('cycle-theme-btn');
        var themeLabel = document.getElementById('theme-label');

        function syncThemeLabel() {
          var current = document.documentElement.getAttribute('data-theme') || 'light';
          if (themeLabel) themeLabel.textContent = labels[current] || 'Paper';
        }
        syncThemeLabel();

        if (themeBtn) {
          themeBtn.addEventListener('click', function () {
            var current = document.documentElement.getAttribute('data-theme') || 'light';
            var next = themes[(themes.indexOf(current) + 1) % themes.length];
            document.documentElement.setAttribute('data-theme', next);
            try {
              localStorage.setItem('techpulse-theme', next);
            } catch (e) {}
            syncThemeLabel();
            if (window.tpTrack) window.tpTrack('theme_switch', { theme: next });
          });
        }

        // Search Modal
        var backdrop = document.getElementById('search-backdrop');
        var openBtn = document.getElementById('open-search-btn');
        var closeBtn = document.getElementById('close-search-btn');
        var input = document.getElementById('global-search-input');
        var resultsContainer = document.getElementById('global-search-results');

        function renderSearchResults(query) {
          if (!resultsContainer) return;
          var q = (query || '').trim().toLowerCase();
          var matches = searchIndex.filter(function (item) {
            if (!q) return true;
            var haystack = [
              item.title,
              item.subtitle,
              item.author,
              item.category,
              (item.tags || []).join(' '),
              (item.cveIds || []).join(' '),
            ]
              .join(' ')
              .toLowerCase();
            return haystack.indexOf(q) !== -1;
          });

          if (matches.length === 0) {
            resultsContainer.innerHTML =
              '<div style="padding:24px 20px; color:var(--ink-muted); font-size:0.875rem;">No matching dispatches or CVE records found.</div>';
            return;
          }

          resultsContainer.innerHTML = matches
            .map(function (m) {
              var cveText =
                m.cveIds && m.cveIds.length
                  ? ' · <span class="font-mono" style="color:var(--crit-text); font-size:0.75rem;">' +
                    m.cveIds[0] +
                    (m.cvss ? ' (' + m.cvss + ')' : '') +
                    '</span>'
                  : '';
              return (
                '<a href="/articles/' +
                m.slug +
                '" class="search-item">' +
                '<div style="font-size:0.75rem; color:var(--ink-muted); margin-bottom:4px;">' +
                '<span style="color:var(--ink); font-weight:500;">' +
                m.author +
                '</span> · ' +
                m.readingTime +
                cveText +
                '</div>' +
                '<div class="font-serif" style="font-weight:600; font-size:1.05rem; color:var(--ink); margin-bottom:2px;">' +
                m.title +
                '</div>' +
                '<div style="font-size:0.82rem; color:var(--ink-secondary); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">' +
                m.subtitle +
                '</div>' +
                '</a>'
              );
            })
            .join('');
        }

        function openSearch() {
          if (!backdrop) return;
          backdrop.classList.add('open');
          renderSearchResults(input ? input.value : '');
          setTimeout(function () {
            if (input) input.focus();
          }, 30);
          if (window.tpTrack) window.tpTrack('search_open');
        }

        function closeSearch() {
          if (!backdrop) return;
          backdrop.classList.remove('open');
        }

        if (openBtn) openBtn.addEventListener('click', openSearch);
        if (closeBtn) closeBtn.addEventListener('click', closeSearch);
        if (backdrop) {
          backdrop.addEventListener('click', function (e) {
            if (e.target === backdrop) closeSearch();
          });
        }
        var searchTimer;
        if (input) {
          input.addEventListener('input', function () {
            renderSearchResults(input.value);
            clearTimeout(searchTimer);
            var val = (input.value || '').trim();
            if (val.length >= 2) {
              searchTimer = setTimeout(function () {
                if (window.tpTrack) window.tpTrack('search', { search_term: val });
              }, 600);
            }
          });
        }

        // Support ?q= query parameter from Schema.org SearchAction
        try {
          var urlParams = new URLSearchParams(window.location.search);
          var qParam = urlParams.get('q');
          if (qParam && input && backdrop) {
            input.value = qParam;
            openSearch();
          }
        } catch (e) {}

        document.addEventListener('keydown', function (e) {
          if (e.key === '/' && document.activeElement !== input && !['INPUT', 'TEXTAREA'].includes((document.activeElement || {}).tagName)) {
            e.preventDefault();
            openSearch();
          } else if (e.key === 'Escape' && backdrop && backdrop.classList.contains('open')) {
            closeSearch();
          }
        });

        // Bookmarks (Reading List)
        function getBookmarks() {
          try {
            return JSON.parse(localStorage.getItem('techpulse-bookmarks') || '[]');
          } catch (e) {
            return [];
          }
        }

        function saveBookmarks(list) {
          try {
            localStorage.setItem('techpulse-bookmarks', JSON.stringify(list));
          } catch (e) {}
        }

        function renderSidebarBookmarks() {
          var box = document.getElementById('sidebar-bookmarks-list');
          if (!box) return;
          var slugs = getBookmarks();
          if (!slugs.length) {
            box.innerHTML =
              '<p style="font-size:0.8125rem; color:var(--ink-muted); margin:0; line-height:1.5;">Select the bookmark icon on any dispatch to save it here for offline or later reading.</p>';
            return;
          }
          var items = searchIndex.filter(function (a) {
            return slugs.indexOf(a.slug) !== -1;
          });
          box.innerHTML = items
            .map(function (item) {
              return (
                '<div style="padding:8px 0;">' +
                '<div style="font-size:0.75rem; color:var(--ink-muted); margin-bottom:2px;">' +
                item.author +
                ' · ' +
                item.readingTime +
                '</div>' +
                '<a href="/articles/' +
                item.slug +
                '" class="font-serif" style="font-weight:600; font-size:0.95rem; color:var(--ink); display:block; line-height:1.32;">' +
                item.title +
                '</a>' +
                '</div>'
              );
            })
            .join('');
        }

        function syncBookmarkButtons() {
          var slugs = getBookmarks();
          document.querySelectorAll('[data-bookmark-slug]').forEach(function (btn) {
            var slug = btn.getAttribute('data-bookmark-slug');
            var isSaved = slugs.indexOf(slug) !== -1;
            btn.classList.toggle('saved', isSaved);
            btn.setAttribute('aria-pressed', isSaved ? 'true' : 'false');
          });
          renderSidebarBookmarks();
        }

        document.addEventListener('click', function (e) {
          var btn = e.target.closest('[data-bookmark-slug]');
          if (!btn) return;
          e.preventDefault();
          var slug = btn.getAttribute('data-bookmark-slug');
          var slugs = getBookmarks();
          var idx = slugs.indexOf(slug);
          var action = 'remove';
          if (idx === -1) {
            slugs.push(slug);
            action = 'save';
          } else {
            slugs.splice(idx, 1);
          }
          saveBookmarks(slugs);
          syncBookmarkButtons();
          if (window.tpTrack) {
            window.tpTrack('bookmark_toggle', { article_slug: slug, action: action });
          }
        });

        syncBookmarkButtons();
      })();
    </script>
  </body>
</html>
