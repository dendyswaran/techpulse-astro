---
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  activeNav?: string;
}

const {
  title = 'TechPulse — Technology Updates, AI & Cybersecurity Digest',
  description = 'A minimalist Medium-inspired editorial publication covering the latest technology updates, autonomous AI breakthroughs, and verified October 2026 security vulnerability advisories (CVEs).',
  activeNav = 'home',
} = Astro.props;

const allArticles = await getCollection('articles');
const searchIndex = allArticles
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((entry) => ({
    slug: entry.slug,
    title: entry.data.title,
    subtitle: entry.data.subtitle,
    category: entry.data.category,
    tags: entry.data.tags,
    cveIds: entry.data.cveIds || [],
    severity: entry.data.severity || null,
    cvss: entry.data.cvss || null,
    readingTime: entry.data.readingTime,
  }));
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('techpulse-theme') || 'light';
          document.documentElement.setAttribute('data-theme', saved);
          var savedFont = localStorage.getItem('techpulse-font-size');
          if (savedFont) {
            document.documentElement.style.setProperty('--article-font-size', savedFont);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <div class="brand-wrap">
          <a href="/" class="brand-logo" aria-label="TechPulse Home">
            TechPulse<span class="brand-dot"></span>
          </a>
          <span class="brand-tagline">Technology, AI & Cybersecurity Digest</span>
        </div>

        <nav class="main-nav" aria-label="Primary Navigation">
          <a href="/" class:list={['nav-link', { active: activeNav === 'home' }]}>Home</a>
          <a href="/category/ai" class:list={['nav-link', { active: activeNav === 'ai' }]}>AI</a>
          <a href="/category/security" class:list={['nav-link', { active: activeNav === 'security' }]}>Security & CVEs</a>
          <a href="/category/tech-update" class:list={['nav-link', { active: activeNav === 'tech-update' }]}>Tech Updates</a>
          <a href="/category/tech-news" class:list={['nav-link', { active: activeNav === 'tech-news' }]}>Tech News</a>
          <a href="/security" class:list={['nav-link nav-link-cve', { active: activeNav === 'cve-matrix' }]}>
            <span>●</span> CVE Matrix
          </a>
        </nav>

        <div class="header-actions">
          <button type="button" class="search-trigger" id="open-search-btn" aria-label="Search articles or CVEs">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span>Search articles or CVEs...</span>
            <kbd class="search-kbd">/</kbd>
          </button>

          <div class="theme-switcher" role="group" aria-label="Reading Theme">
            <button type="button" class="theme-btn" data-set-theme="light" title="Light Mode">Light</button>
            <button type="button" class="theme-btn" data-set-theme="sepia" title="Sepia Reading Mode">Sepia</button>
            <button type="button" class="theme-btn" data-set-theme="dark" title="Dark Mode">Dark</button>
          </div>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Instant Search Modal -->
    <div class="search-backdrop" id="search-backdrop" role="dialog" aria-modal="true" aria-label="Search Articles and CVEs">
      <div class="search-modal">
        <div class="search-input-wrap">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--ink-muted)">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="search"
            id="global-search-input"
            class="search-input"
            placeholder="Search by title, topic (Node.js, Bun, PHP, Claude), or CVE ID..."
            autocomplete="off"
          />
          <button type="button" id="close-search-btn" class="search-kbd" style="cursor:pointer;">ESC</button>
        </div>
        <div class="search-results" id="global-search-results"></div>
      </div>
    </div>

    <footer class="site-footer">
      <div class="container-wide" style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:16px;">
        <div>
          <strong class="font-serif" style="font-size:1.1rem; color:var(--ink);">TechPulse</strong>
          <p style="margin:4px 0 0;">Curated Technology Updates, Autonomous AI & Security Vulnerability Advisories — October 2026 Edition.</p>
        </div>
        <div style="display:flex; gap:20px; flex-wrap:wrap;">
          <a href="/">Home</a>
          <a href="/category/ai">Artificial Intelligence</a>
          <a href="/category/security">Security & CVEs</a>
          <a href="/category/tech-update">Tech Updates</a>
          <a href="/security">CVE Matrix</a>
        </div>
      </div>
    </footer>

    <script is:inline define:vars={{ searchIndex }}>
      (function () {
        // 1. Theme Switcher
        function syncThemeButtons() {
          var current = document.documentElement.getAttribute('data-theme') || 'light';
          document.querySelectorAll('[data-set-theme]').forEach(function (btn) {
            btn.classList.toggle('active', btn.getAttribute('data-set-theme') === current);
          });
        }
        syncThemeButtons();

        document.querySelectorAll('[data-set-theme]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var next = btn.getAttribute('data-set-theme');
            document.documentElement.setAttribute('data-theme', next);
            try {
              localStorage.setItem('techpulse-theme', next);
            } catch (e) {}
            syncThemeButtons();
          });
        });

        // 2. Global Instant Search Modal
        var backdrop = document.getElementById('search-backdrop');
        var openBtn = document.getElementById('open-search-btn');
        var closeBtn = document.getElementById('close-search-btn');
        var input = document.getElementById('global-search-input');
        var resultsContainer = document.getElementById('global-search-results');

        function renderSearchResults(query) {
          if (!resultsContainer) return;
          var q = (query || '').trim().toLowerCase();
          var matches = searchIndex.filter(function (item) {
            if (!q) return true;
            var haystack = [
              item.title,
              item.subtitle,
              item.category,
              (item.tags || []).join(' '),
              (item.cveIds || []).join(' '),
            ]
              .join(' ')
              .toLowerCase();
            return haystack.indexOf(q) !== -1;
          });

          if (matches.length === 0) {
            resultsContainer.innerHTML =
              '<div style="padding:24px; text-align:center; color:var(--ink-muted); font-size:0.9rem;">No matching stories or CVE advisories found for that keyword.</div>';
            return;
          }

          resultsContainer.innerHTML = matches
            .map(function (m) {
              var cveBadge =
                m.cveIds && m.cveIds.length
                  ? '<span class="severity-badge severity-' +
                    (m.severity || 'HIGH') +
                    '" style="margin-left:8px;">' +
                    m.cveIds[0] +
                    (m.cvss ? ' · CVSS ' + m.cvss : '') +
                    '</span>'
                  : '';
              return (
                '<a href="/articles/' +
                m.slug +
                '" class="search-item">' +
                '<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:4px;">' +
                '<span style="font-size:0.74rem; font-weight:600; text-transform:uppercase; color:var(--accent);">' +
                m.category +
                cveBadge +
                '</span>' +
                '<span style="font-size:0.75rem; color:var(--ink-muted);">' +
                m.readingTime +
                '</span>' +
                '</div>' +
                '<div class="font-serif" style="font-weight:700; font-size:1.05rem; color:var(--ink); margin-bottom:3px;">' +
                m.title +
                '</div>' +
                '<div style="font-size:0.83rem; color:var(--ink-secondary); display:-webkit-box; -webkit-line-clamp:1; -webkit-box-orient:vertical; overflow:hidden;">' +
                m.subtitle +
                '</div>' +
                '</a>'
              );
            })
            .join('');
        }

        function openSearch() {
          if (!backdrop) return;
          backdrop.classList.add('open');
          renderSearchResults(input ? input.value : '');
          setTimeout(function () {
            if (input) input.focus();
          }, 40);
        }

        function closeSearch() {
          if (!backdrop) return;
          backdrop.classList.remove('open');
        }

        if (openBtn) openBtn.addEventListener('click', openSearch);
        if (closeBtn) closeBtn.addEventListener('click', closeSearch);
        if (backdrop) {
          backdrop.addEventListener('click', function (e) {
            if (e.target === backdrop) closeSearch();
          });
        }
        if (input) {
          input.addEventListener('input', function () {
            renderSearchResults(input.value);
          });
        }

        document.addEventListener('keydown', function (e) {
          if (e.key === '/' && document.activeElement !== input && !['INPUT', 'TEXTAREA'].includes((document.activeElement || {}).tagName)) {
            e.preventDefault();
            openSearch();
          } else if (e.key === 'Escape' && backdrop && backdrop.classList.contains('open')) {
            closeSearch();
          }
        });

        // 3. Bookmarks (Reading List) in localStorage
        function getBookmarks() {
          try {
            return JSON.parse(localStorage.getItem('techpulse-bookmarks') || '[]');
          } catch (e) {
            return [];
          }
        }

        function saveBookmarks(list) {
          try {
            localStorage.setItem('techpulse-bookmarks', JSON.stringify(list));
          } catch (e) {}
        }

        function renderSidebarBookmarks() {
          var box = document.getElementById('sidebar-bookmarks-list');
          if (!box) return;
          var slugs = getBookmarks();
          if (!slugs.length) {
            box.innerHTML =
              '<p style="font-size:0.83rem; color:var(--ink-muted); margin:0;">Click the <strong>Save</strong> icon on any story to bookmark it to your personal reading list.</p>';
            return;
          }
          var items = searchIndex.filter(function (a) {
            return slugs.indexOf(a.slug) !== -1;
          });
          box.innerHTML = items
            .map(function (item) {
              return (
                '<div style="padding:8px 0; border-bottom:1px solid var(--border);">' +
                '<a href="/articles/' +
                item.slug +
                '" class="font-serif" style="font-weight:600; font-size:0.92rem; color:var(--ink); display:block; line-height:1.35;">' +
                item.title +
                '</a>' +
                '<span style="font-size:0.74rem; color:var(--ink-muted);">' +
                item.readingTime +
                '</span>' +
                '</div>'
              );
            })
            .join('');
        }

        function syncBookmarkButtons() {
          var slugs = getBookmarks();
          document.querySelectorAll('[data-bookmark-slug]').forEach(function (btn) {
            var slug = btn.getAttribute('data-bookmark-slug');
            var isSaved = slugs.indexOf(slug) !== -1;
            btn.classList.toggle('saved', isSaved);
            var label = btn.querySelector('.bm-label');
            if (label) label.textContent = isSaved ? 'Saved' : 'Save';
          });
          renderSidebarBookmarks();
        }

        document.addEventListener('click', function (e) {
          var btn = e.target.closest('[data-bookmark-slug]');
          if (!btn) return;
          e.preventDefault();
          var slug = btn.getAttribute('data-bookmark-slug');
          var slugs = getBookmarks();
          var idx = slugs.indexOf(slug);
          if (idx === -1) {
            slugs.push(slug);
          } else {
            slugs.splice(idx, 1);
          }
          saveBookmarks(slugs);
          syncBookmarkButtons();
        });

        syncBookmarkButtons();
      })();
    </script>
  </body>
</html>
