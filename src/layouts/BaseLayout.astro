---
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  activeNav?: string;
  ogImage?: string;
}

const {
  title = 'TechPulse',
  description = 'Independent reporting on software systems, foundation models, and runtime security advisories.',
  activeNav = 'home',
  ogImage,
} = Astro.props;

const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://techpulsenews.tech';
const resolvedOgImage = ogImage
  ? ogImage.startsWith('http')
    ? ogImage
    : `${siteOrigin}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`
  : undefined;

const allArticles = await getCollection('articles');
const searchIndex = allArticles
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((entry) => ({
    slug: entry.slug,
    title: entry.data.title,
    subtitle: entry.data.subtitle,
    category: entry.data.category,
    author: entry.data.author.name,
    tags: entry.data.tags,
    cveIds: entry.data.cveIds || [],
    severity: entry.data.severity || null,
    cvss: entry.data.cvss || null,
    readingTime: entry.data.readingTime,
  }));
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    <meta name="twitter:card" content={resolvedOgImage ? 'summary_large_image' : 'summary'} />
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('techpulse-theme') || 'light';
          document.documentElement.setAttribute('data-theme', saved);
          var savedFont = localStorage.getItem('techpulse-font-size');
          if (savedFont) {
            document.documentElement.style.setProperty('--article-font-size', savedFont);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand-wordmark" aria-label="TechPulse Home">TechPulse</a>

        <div class="header-utilities">
          <button type="button" class="util-btn" id="open-search-btn" aria-label="Search">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <circle cx="11" cy="11" r="7.5"></circle>
              <line x1="20" y1="20" x2="16.2" y2="16.2"></line>
            </svg>
            <span>Search</span>
          </button>

          <a href="/security" class:list={['util-link', { active: activeNav === 'cve-matrix' }]}>
            CVEs
          </a>

          <button type="button" class="util-btn" id="cycle-theme-btn" aria-label="Cycle reading theme" title="Switch reading theme">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <circle cx="12" cy="12" r="4.5"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
            </svg>
            <span id="theme-label">Paper</span>
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Search Modal -->
    <div class="search-backdrop" id="search-backdrop" role="dialog" aria-modal="true" aria-label="Search">
      <div class="search-modal">
        <div class="search-input-wrap">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" style="color: var(--ink-muted)">
            <circle cx="11" cy="11" r="7.5"></circle>
            <line x1="20" y1="20" x2="16.2" y2="16.2"></line>
          </svg>
          <input
            type="search"
            id="global-search-input"
            class="search-input"
            placeholder="Search stories, authors, or CVE identifiers..."
            autocomplete="off"
          />
          <button type="button" id="close-search-btn" class="util-btn" style="font-size:0.75rem;">Esc</button>
        </div>
        <div class="search-results" id="global-search-results"></div>
      </div>
    </div>

    <footer class="site-footer">
      <div class="container-wide" style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:baseline; gap:16px;">
        <div>
          <span class="font-serif" style="font-weight:600; color:var(--ink);">TechPulse</span>
          <span style="margin-left:10px;">Systems, AI &amp; Security Advisories</span>
        </div>
        <div style="display:flex; gap:20px; flex-wrap:wrap;">
          <a href="/" class="util-link">Archive</a>
          <a href="/category/ai" class="util-link">AI</a>
          <a href="/category/security" class="util-link">Security</a>
          <a href="/category/tech-update" class="util-link">Systems</a>
          <a href="/category/tech-news" class="util-link">Industry</a>
          <a href="/security" class="util-link">CVE Index</a>
        </div>
      </div>
    </footer>

    <script is:inline define:vars={{ searchIndex }}>
      (function () {
        var themes = ['light', 'sepia', 'dark'];
        var labels = { light: 'Paper', sepia: 'Sepia', dark: 'Night' };
        var themeBtn = document.getElementById('cycle-theme-btn');
        var themeLabel = document.getElementById('theme-label');

        function syncThemeLabel() {
          var current = document.documentElement.getAttribute('data-theme') || 'light';
          if (themeLabel) themeLabel.textContent = labels[current] || 'Paper';
        }
        syncThemeLabel();

        if (themeBtn) {
          themeBtn.addEventListener('click', function () {
            var current = document.documentElement.getAttribute('data-theme') || 'light';
            var next = themes[(themes.indexOf(current) + 1) % themes.length];
            document.documentElement.setAttribute('data-theme', next);
            try {
              localStorage.setItem('techpulse-theme', next);
            } catch (e) {}
            syncThemeLabel();
          });
        }

        // Search Modal
        var backdrop = document.getElementById('search-backdrop');
        var openBtn = document.getElementById('open-search-btn');
        var closeBtn = document.getElementById('close-search-btn');
        var input = document.getElementById('global-search-input');
        var resultsContainer = document.getElementById('global-search-results');

        function renderSearchResults(query) {
          if (!resultsContainer) return;
          var q = (query || '').trim().toLowerCase();
          var matches = searchIndex.filter(function (item) {
            if (!q) return true;
            var haystack = [
              item.title,
              item.subtitle,
              item.author,
              item.category,
              (item.tags || []).join(' '),
              (item.cveIds || []).join(' '),
            ]
              .join(' ')
              .toLowerCase();
            return haystack.indexOf(q) !== -1;
          });

          if (matches.length === 0) {
            resultsContainer.innerHTML =
              '<div style="padding:24px 20px; color:var(--ink-muted); font-size:0.875rem;">No matching articles found.</div>';
            return;
          }

          resultsContainer.innerHTML = matches
            .map(function (m) {
              var cveText =
                m.cveIds && m.cveIds.length
                  ? ' · <span class="font-mono" style="color:var(--crit-text); font-size:0.75rem;">' +
                    m.cveIds[0] +
                    (m.cvss ? ' (' + m.cvss + ')' : '') +
                    '</span>'
                  : '';
              return (
                '<a href="/articles/' +
                m.slug +
                '" class="search-item">' +
                '<div style="font-size:0.75rem; color:var(--ink-muted); margin-bottom:4px;">' +
                '<span style="color:var(--ink); font-weight:500;">' +
                m.author +
                '</span> · ' +
                m.readingTime +
                cveText +
                '</div>' +
                '<div class="font-serif" style="font-weight:600; font-size:1.05rem; color:var(--ink); margin-bottom:2px;">' +
                m.title +
                '</div>' +
                '<div style="font-size:0.82rem; color:var(--ink-secondary); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">' +
                m.subtitle +
                '</div>' +
                '</a>'
              );
            })
            .join('');
        }

        function openSearch() {
          if (!backdrop) return;
          backdrop.classList.add('open');
          renderSearchResults(input ? input.value : '');
          setTimeout(function () {
            if (input) input.focus();
          }, 30);
        }

        function closeSearch() {
          if (!backdrop) return;
          backdrop.classList.remove('open');
        }

        if (openBtn) openBtn.addEventListener('click', openSearch);
        if (closeBtn) closeBtn.addEventListener('click', closeSearch);
        if (backdrop) {
          backdrop.addEventListener('click', function (e) {
            if (e.target === backdrop) closeSearch();
          });
        }
        if (input) {
          input.addEventListener('input', function () {
            renderSearchResults(input.value);
          });
        }

        document.addEventListener('keydown', function (e) {
          if (e.key === '/' && document.activeElement !== input && !['INPUT', 'TEXTAREA'].includes((document.activeElement || {}).tagName)) {
            e.preventDefault();
            openSearch();
          } else if (e.key === 'Escape' && backdrop && backdrop.classList.contains('open')) {
            closeSearch();
          }
        });

        // Bookmarks (Reading List)
        function getBookmarks() {
          try {
            return JSON.parse(localStorage.getItem('techpulse-bookmarks') || '[]');
          } catch (e) {
            return [];
          }
        }

        function saveBookmarks(list) {
          try {
            localStorage.setItem('techpulse-bookmarks', JSON.stringify(list));
          } catch (e) {}
        }

        function renderSidebarBookmarks() {
          var box = document.getElementById('sidebar-bookmarks-list');
          if (!box) return;
          var slugs = getBookmarks();
          if (!slugs.length) {
            box.innerHTML =
              '<p style="font-size:0.8125rem; color:var(--ink-muted); margin:0; line-height:1.5;">Click the bookmark icon on any story to save it here for offline or later reading.</p>';
            return;
          }
          var items = searchIndex.filter(function (a) {
            return slugs.indexOf(a.slug) !== -1;
          });
          box.innerHTML = items
            .map(function (item) {
              return (
                '<div style="padding:8px 0;">' +
                '<div style="font-size:0.75rem; color:var(--ink-muted); margin-bottom:2px;">' +
                item.author +
                ' · ' +
                item.readingTime +
                '</div>' +
                '<a href="/articles/' +
                item.slug +
                '" class="font-serif" style="font-weight:600; font-size:0.95rem; color:var(--ink); display:block; line-height:1.32;">' +
                item.title +
                '</a>' +
                '</div>'
              );
            })
            .join('');
        }

        function syncBookmarkButtons() {
          var slugs = getBookmarks();
          document.querySelectorAll('[data-bookmark-slug]').forEach(function (btn) {
            var slug = btn.getAttribute('data-bookmark-slug');
            var isSaved = slugs.indexOf(slug) !== -1;
            btn.classList.toggle('saved', isSaved);
            btn.setAttribute('aria-pressed', isSaved ? 'true' : 'false');
          });
          renderSidebarBookmarks();
        }

        document.addEventListener('click', function (e) {
          var btn = e.target.closest('[data-bookmark-slug]');
          if (!btn) return;
          e.preventDefault();
          var slug = btn.getAttribute('data-bookmark-slug');
          var slugs = getBookmarks();
          var idx = slugs.indexOf(slug);
          if (idx === -1) {
            slugs.push(slug);
          } else {
            slugs.splice(idx, 1);
          }
          saveBookmarks(slugs);
          syncBookmarkButtons();
        });

        syncBookmarkButtons();
      })();
    </script>
  </body>
</html>
